\newcommand{\hyper}[1]{\textcolor{blue}{#1}}
%\newcommand{\todo}[1]{\textcolor{red}{#1}}
\newcommand{\negnum}[1]{\textcolor{red}{#1}}
\newcommand{\nn}[1]{\textcolor{red}{#1}}
\newcommand{\ns}[1]{\textcolor{red}{\bf{#1}}}
\newcommand{\s}[1]{\bf{#1}}

%allows the definition of our own headers and footers
\usepackage{fancyhdr}
\pagestyle{fancy}

%add to the height of the header to allow for the extra line in the fancy header
\addtolength{\headheight}{2.5pt}

%set up the spacing of the page for the document
%\addtolength{\evensidemargin}{-30pt}
%\addtolength{\oddsidemargin}{30pt}

\pdfpagewidth 21cm
\pdfpageheight 29.7cm

%\setlength\topmargin{0cm}
\setlength\oddsidemargin{1.7cm}
\setlength\evensidemargin{-0.3cm}
\setlength\textwidth{14.6cm}
\setlength\marginparwidth{0cm}
\setlength\textheight{22.8cm}
\setlength\headwidth {14.6cm}
\setlength\voffset{-1cm}


%sets up the chapter and section marks to follow the desired format to be displayed in the header of the pages.
\renewcommand{\chaptermark}[1]{\markboth{\chaptername\ \thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection.\ #1}{}}

%For controlling start chapter number if I'm not printing them in order, so as not to confuse supervisors etc.
%Note, the first printed chapter will be one above this number
%\setcounter {chapter} {3} 

%2: number subsections but not subsubsections
\setcounter{secnumdepth}{2}

%2: displays subsection but not subsubsections
\setcounter{tocdepth}{2}

\makeindex

\include{Glossary_n_acronyms/Acronyms}

%make the gloa
\makeglossary


