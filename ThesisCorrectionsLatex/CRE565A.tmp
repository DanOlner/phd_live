% insert a blank page to ensure that the new section starts on the right. Also makes sure that the headings stay consistent.
\cleardoublepage


%ensures that the blank pages that follow a chapter that ends on an odd page is empty
\clearpage{\pagestyle{empty}\cleardoublepage}

% insert a blank page to ensure that the new section starts on the right. Also makes sure that the headings stay consistent.
\cleardoublepage

%overrides the plain page style to show the page number in the center but otherwise appear blank
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}

%set up the fancy style for the preamble section
%clear the header and the footer
\fancyhead{}
\fancyfoot{}
%set the page numbering to be in roman numerals
\pagenumbering{roman}
%enter the page number into the footer
\fancyfoot[C]{\thepage}
%set up the lines in the header and footer
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0pt}



%create the preamble - table of contents etc...
%\addcontentsline{toc}{chapter}{Table of Contents} - surely doesn't need reference to itself
\fancyhead[RO]{Table of Contents}
\fancyhead[LE]{Table of Contents}
\tableofcontents 
