%http://www.macfreek.nl/mindmaster/LaTeX_package_conflicts#Caption_and_Subfig
%Yup, that worked. Got small captions.
\usepackage{subfig}

%manages acronyms in the text and ensures that they are all expanded at least once
%\usepackage{acronym}

%trying glossaries instead
\usepackage[toc,acronym]{glossaries}

%Make first glossary entries bold
%\renewcommand{\glstextformat}[1]{\textbf{#1}}  
%From http://latex-community.org/forum/viewtopic.php?f=5&t=11538&p=76278#p76278
\renewcommand*{\glsdisplayfirst}[4]{\textbf{#1#4}}

