\usepackage[colorinlistoftodos]{todonotes}

%extra todo defs
\newcommand{\fixref}[1]{\todo[inline,color=green!40]{#1}}
\newcommand{\cmt}[1]{\todo[inline,color=red!40]{#1}}

%set spacing for the document
\usepackage{setspace}
\onehalfspacing

% Use standard Postscript fonts
\usepackage{pslatex}

%use the package for fancy verbatim environments
\usepackage{fancyvrb}

