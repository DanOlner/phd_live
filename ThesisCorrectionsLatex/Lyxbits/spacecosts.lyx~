\end_inset


\end_layout

\begin_layout Itemize
Firm: 
\begin_inset Formula $x=g(time,factor1)$
\end_inset


\end_layout

\begin_layout Standard
No space there! Keep in mind Scitovsky's two definitions for tech and pecuniary
 externalities:
\end_layout

\begin_layout Standard
