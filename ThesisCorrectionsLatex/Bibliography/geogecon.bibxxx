@article{krugman_whats_1998,
	title = {What's new about the new economic geography?},
	volume = {14},
	abstract = {Since 1990 a new genre of research, often described as the ŉew economic geography', has emerged. It diﬀers from traditional work in economic geography mainly in adopting a modelling strategy that exploits the same technical tricks that hale played such a large role in the ŉew trade' and ŉew growth' theories; these modelling tricks, while they preclude any claims of generality, do allow the construction of models that-unlike most traditional spatial analysis-are fully general-equilibrium and clearly derive aggregate behaviour from individual maximization. The new work is highly suggestive, particularly in indicating how historical accident can shape economic geography, and how gradual changes in underlying parameters can produce discontinuous change in spatial structure. It also serves the important purpose of placing geographical analysis squarely in the economic mainstream.},
	journal = {Oxford Review of Economic Policy},
	author = {P. Krugman},
	year = {1998},
	note = {{SumArticleWhat's} new about the new economic {geography?ISI:00007512150000230OXFORD} {UNIV} {PRESSEnglish}},
	keywords = {economics, geography},
	pages = {7--17}
},

@article{storper_agglomeration_2010,
	title = {Agglomeration, Trade, and Spatial Development: Bringing Dynamics Back In},
	volume = {50},
	issn = {0022-4146},
	shorttitle = {{AGGLOMERATION,} {TRADE,} {AND} {SPATIAL} {DEVELOPMENT}},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&colname=WOS&search_mode=CitingArticles&qid=4&SID=S2JalPmgknOkea34cgI&page=1&doc=1},
	doi = {10.1111/j.1467-9787.2009.00658.x},
	abstract = {The field of spatial economics has made enormous progress in theorizing and measuring agglomeration effects, trade costs, and urbanization. Typical models establish structural determinants by making strong assumptions about which forces are relevant and how these forces interact. But many of these assumptions, about firms, agents, spatial costs, and market structures, are questionable. As a result, the field has a long way to go to establish causality, and to be able to account for spatial economic dynamics.},
	number = {1},
	journal = {Journal of Regional Science},
	author = {M Storper},
	month = feb,
	year = {2010},
	keywords = {agglomeration, economics, geography},
	pages = {313--342}
},

@book{fujita_spatial_2001,
	edition = {New edition},
	title = {The Spatial Economy: Cities, Regions and International Trade},
	isbn = {0262561476},
	shorttitle = {The Spatial Economy},
	publisher = {{MIT} Press},
	author = {M. Fujita and P. Krugman and {A.J.} Venables},
	month = sep,
	year = {2001},
	keywords = {economics, geography, localisation},
	annote = {{\textless}h3 {style="padding-left:30px;"{\textgreater}Intro:{\textless}/h3{\textgreater}}
{\textless}p style="padding-left:30px;"{\textgreater}p.1: nice def of agglomeration - "the clustering of economic activity, created and sustained by some sort of circular logic". {OK,} it's a bit vague, but useful!{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}Or} p4: "in which spatial concentration itself creates the favourable economic environment that supports further or continued concentration."{\textless}/p{\textgreater}
{\textless}h3 {style="padding-left:30px;"{\textgreater}{\textless}strong{\textgreater}Increasing} returns: {\textless}/strong{\textgreater}{\textless}/h3{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}Most} theory presumes constant returns - but if this, why not 'backyard capitalism' where everyone produces their own goods? {(Cf.} C19th - many did do this.){\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}Disparities} between regions - "surely the result not of inherent differences among locations but of some set of cumulative processes, necessarily involving some form of increasing returns, whereby geographic concentration can be self-reinforcing." [2]{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}IncRets:} mathematically tricky, posing problems for equilibria.{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}Options} - e.g. Von Thunen: take position and existence of cities as given, "trace out consequences for land rents and land use."{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}Or:} Henderson (74, 80,88): inc rets = black box 'localisation externalities'.{\textless}/p{\textgreater}
{\textless}h3 {style="padding-left:30px;"{\textgreater}{\textless}strong{\textgreater}NEG{\textless}/strong{\textgreater}:{\textless}/h3{\textgreater}}
{\textless}p {style="padding-left:30px;"{\textgreater}Begins} with {Dixit-Stiglitz} - 'a formalization of Chamberlin's concept of monop comp that, though admittedly a very special case, has turned into the workhorse of theoretical modelling in a number of fields.' [3] Because analytically tractable.{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}New} trade and new growth theory: the books -{\textless}/p{\textgreater}
{\textless}ul {style="padding-left:30px;"{\textgreater}{\textless}li{\textgreater}Helpman} / Krugman - Market structure and foreign trade (85){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Grossman} / Helpman - Innovation and growth in the world economy (91){\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}h3 {style="padding-left:30px;"{\textgreater}Linkages} and circular causation:{\textless}/h3{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}'Defining} issue' of econgeog - need to explain concentrations of pop and econ activity; distinction betw manuf and agri belt.{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}[I} wonder: what are my questions?]{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}Aim} of {NEG:} to get inside black box of agglomeration economies to "derive the self-reinforcing character of spatial concentration from more fundamental considerations." [4]{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}Marshall's} three 'returns to spatial concentration' -{\textless}/p{\textgreater}
{\textless}ol {style="padding-left:30px;"{\textgreater}{\textless}li{\textgreater}Knowledge} spillovers{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Advantages} of 'thick markets' for specialised skills [more please!]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Backward} and forward linkages in large local markets{\textless}/li{\textgreater}
{\textless}/ol{\textgreater}{\textless}p style="padding-left:30px;"{\textgreater}1st two - downplayed because hard to model.{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}"Loose-jointed} modelling is, we believe, underappreciated in economics." [5]{\textless}/p{\textgreater}
{\textless}p {style="padding-left:30px;"{\textgreater}{\textless}strong{\textgreater}What} "linkages" doesn't address:{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}ul {style="padding-left:30px;"{\textgreater}{\textless}li{\textgreater}The} nature of competition            
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Without} increasing returns at the level of the firm, they'd "establish separate facilities to serve each market."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"But} if there are increasing returns, competition must be imperfect; how do firms compete and set prices?" [why?] [6]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}And} transport costs...?{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}h3{\textgreater}Modelling} tricks: [6]{\textless}/h3{\textgreater}
{\textless}p{\textgreater}"... assumptions that reflect not so much a realistic view of how the world works as a judgement about what will make the analysis of geographic issues manageable without doing too much damage to the relevance of that analysis."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"We} are aware that this lends the analysis a certain air of unreality, that this book sometimes looks as if it should be entitled {{\textless}em{\textgreater}Games} you Can Play with {CES} Functions{\textless}/em{\textgreater}. Nonetheless, we regard the advantages of the {Dixit-Stiglitz} model as overwhelming for our purposes."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Use} of {DxSt:} reconcile 2 seemingly incompatible things - "respecting the integer nature of indiv choices under increasing returns while representing the aggregate of such choices with continuous variables (such as the share of production carried out in a particular location.)" [7]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Nice:} {"Dixit} Stiglitz lets us have our cake in discrete lumps while doing calculus on it, too." [7]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Notes} Samuelson transport iceberg assumption; "there turns out to be a tremendous synergy between the assumption of iceberg transport costs and the {DxSt} model, in the sense that combining them causes many potentially nasty technical complications simply to, well, melt away." [7]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Big} break: using evolutionary models to make sense of essentially static models.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"When} one speaks of a {\textless}em{\textgreater}cumulative process{\textless}/em{\textgreater} by which spatial concentration reinforces itself, one has a definite image of a snowballing urban or regional concentation, developing over time. Yet to insist that models of economic geography explicitly model firms and households as making intertemporal decisions based on rational expectations would greatly complicate an already difficult subject." [7]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"A} hallmark of the new economic geography, as compared with the new trade and new growth literatures, has been its willingness to turn where necessary to computer-assisted thinking: to use high-tech numerical examples to guide and supplement analytical results."{\textless}/p{\textgreater}
{\textless}p{\textgreater}-- so, all the bad things about equilibrium analysis, and all the bad things about computers. How does this compare to {ABM?{\textless}/p{\textgreater}}
{\textless}p{\textgreater}-- and how fair is it to oppose 'analytical' and 'numerical' and dismiss the latter? {(Possibly,} it is. But what are the grounds?){\textless}/p{\textgreater}
{{\textless}h3{\textgreater}Two} useful questions:{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}When} is a spatial concentration of economic activity sustainable? (... whether the economy can support something other than backyard capitalism, whether backyard capitalism is a necessary outcome) {\textless}strong{\textgreater}[is it an equilibrium?]{\textless}/strong{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}When} is a symmetric equilibrium, without spatial concentration, unstable? (does backyard capitalism necessarily unravel; is it even a {\textless}em{\textgreater}possible{\textless}/em{\textgreater} outcome?){\textless}strong{\textgreater} [is the equilibrium stable?]{\textless}/strong{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}Difference} between the two: {\textless}strong{\textgreater}petal / fugal forces. {\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"Can} derive explicit formulas for the 'sustain point' at which an economy with agglomeration becomes possible and the 'break point' at which an economy without agglomeration becomes unstable." [10] {[Sustain} point: guess, then confirm that guess. Break point: linearize then solve...]{\textless}/p{\textgreater}
{\textless}p{\textgreater}-- which makes me wonder about my questions... Under what future conditions might our economy be sustainable? How will the spatial morphology change?{\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}},
	annote = {{{\textless}h2{\textgreater}Lit} review{\textless}/h2{\textgreater}
{{\textless}h3{\textgreater}Urban} economics{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}If} economists talk about space at all, they tend to turn to von Thunen [15]{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}Von} Thunen summary{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Isolate} town supplied by farmers{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Crops} differ in 
{\textless}ul{\textgreater}{\textless}li{\textgreater}yield per acre{\textless}/li{\textgreater}
{\textless}li{\textgreater}transportation costs{\textless}/li{\textgreater}
{\textless}li{\textgreater}can be produced with different intensities of cultivation{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}His} questions: 
{{\textless}ul{\textgreater}{\textless}li{\textgreater}"How} should the land around the town be allocated to minimize the combined costs of producing and transporting a given supply of food to the town?" [16]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"How} will the land actually be allocated if there is an unplanned competition among farmers and landowners, with each individual acting in his own perceived self-interest?"{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Result:} 
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Competition} -- "a gradient of land rents that declines from a maximum at the town to zero at the outermost limit of cultivation" 
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Farmer:} faces trade-off betw land rent and transport costs - "because transport costs and yields differ among crops, a pattern of concentric rings of production will result."{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}}
},

@article{krugman_increasing_2009-1,
	title = {The Increasing Returns Revolution in Trade and Geography},
	volume = {99},
	issn = {0002-8282},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&search_mode=GeneralSearch&qid=1&SID=P1M6hL8JlLll8cb4F3b&page=1&doc=1},
	doi = {10.1257/aer.99.3.561},
	abstract = {Thirty years have passed since a small group of theorists began applying concepts and tools from industrial organization to the analysis of international trade. The new models of trade that emerged from that work didn't supplant traditional trade theory so much as supplement it, creating an integrated view that made sense of aspects of world trade that had previously posed major puzzles. The "new trade theory"-an unfortunate phrase, now quite often referred to as "the old new trade theory"-also helped build a bridge between the analysis of trade between countries and the location of production within countries. In this paper I will try to retrace the steps and, perhaps even more important, the state of mind that made this intellectual transformation possible. At the end I'll also ask about the relevance of those once-revolutionary insights in a world economy that, as I'll explain, is arguably more classical now than it was when the revolution in trade theory began.},
	number = {3},
	journal = {{AMERICAN} {ECONOMIC} {REVIEW}},
	author = {P Krugman},
	month = jun,
	year = {2009},
	keywords = {geographical economics},
	pages = {561--571}
},

