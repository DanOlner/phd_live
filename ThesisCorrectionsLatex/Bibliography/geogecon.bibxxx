@incollection{audretsch_knowledge_2004,
	title = {Knowledge spillovers and the geography of innovation},
	volume = {Volume 4},
	isbn = {1574-0080},
	url = {http://www.sciencedirect.com/science/article/B7P64-4FFPH84-2R/2/2c557f0d93ea190abcc8a573e7d47217},
	abstract = {This chapter focuses on the geographic dimensions of knowledge spillovers. The starting point comes from the economics of innovation and technological change. This tradition focused on the innovation production function however it was aspatial or insensitive to issues involving location and geography. However, empirical results hinted that knowledge production had a spatial dimension. Armed with a new theoretical understanding about the role and significance of knowledge spillovers and the manner in which they are localized, scholars began to estimate the knowledge production function with a spatial dimension. Location and geographic space have become key factors in explaining the determinants of innovation and technological change. The chapter also identifies new insights that have sought to penetrate the black box of geographic space by addressing a limitation inherent in the model of the knowledge production. These insights come from a rich tradition of analyzing the role of both localization and urbanization economies, by extending the focus to the organization of economic activity within a spatial dimension and examine how different organizational aspects influence economic performance. While the endogenous growth theory emphasizes the importance of investments in research and development and human capital, a research agenda needs to be mapped out identifying the role that investments in spillover conduits can make in generating economic growth. It may be that a mapping of the process by which new knowledge is created, externalized and commercialized, hold the key to providing the microeconomic linkages to endogenous macroeconomic growth.},
	booktitle = {Handbook of Regional and Urban Economics},
	publisher = {Elsevier},
	author = {David B. Audretsch and Maryann P. Feldman and J. Vernon Henderson and {Jacques-Francois} Thisse},
	year = {2004},
	keywords = {economics, geography, knowledge, localisation},
	pages = {2713--2739},
	annote = {{{\textless}h3{\textgreater}Intro{\textless}br} /{\textgreater}{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}New} lit - goal: 'understanding the spatial dimension of innovative activity' [1]{\textless}/p{\textgreater}
{\textless}p{\textgreater}"specifically the determinants and mechanisms that underlie the propensity of innovative activity to cluster spatially."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Started} with an aspatial 'innovation production function.'{\textless}/p{\textgreater}
{\textless}p{\textgreater}- all concentrating on {\textless}strong{\textgreater}industrial {\textless}/strong{\textgreater}clustering.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Later} studies: following in the rich tradition of Hoover - brilliant!{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Unclear} - "how and why knowledge spills over."{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}The} knowledge production function{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}At} the firm level - {R\&amp;D.} Other measures - human capital, skilled labour, education levels.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}But} basically just a Cobb {Douglas.Unit} has been countries, industries, enterprises.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Jacobs} (1969) - talks about the difference between information and knowledge. Hmmph.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Manski} - 'social interactions have economic value in trasmitting knowledge and ideas.' [7]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Von} Hipple (1994) coined 'sticky knowledge'{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"An} implication of the distinction between information and tacit knowledge is that the marginal cost of transmitting information across geographic space has been rendered invariant by the revolution in telecommunications while the marginal cost of transmitting knowledge, especially tacit knowledge, is lowest with frequent social interaction, observation and communication." [7]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Feldman} - 1994ish - 'location mitigates the inherent uncertainty of innovative activity.... innovation clusters spatially where knowledge externalities reduce the costs of scientific discovery and commercialisation.'{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Jaffe} 1989 - adding to a very Cobb Douglas looking thing, adding e.g. research expenditures of universities.{\textless}/p{\textgreater}
{\textless}p{\textgreater}// got to about p20{\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}}
},

@article{storper_rethinking_2009,
	title = {Rethinking human capital, creativity and urban growth},
	volume = {9},
	issn = {1468-2702},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&colname=WOS&search_mode=CitingArticles&qid=4&SID=S2JalPmgknOkea34cgI&page=2&doc=13},
	doi = {10.1093/jeg/lbn052},
	abstract = {Do jobs follow people or do people follow jobs A number of currently prominent approaches to urbanization respond to this question by privileging the role of individual locational choice in response to amenity values as the motor of contemporary urban growth. Amenities, it is often said, have an especially potent effect on the migration patterns of individuals endowed with high levels of human capital. However, these approaches raise many unanswered questions. Theories that describe urban growth as a response to movements of people in search of consumer or lifestyle preferences can be questioned on the grounds of their assumptions about human behavior, as well as their silence in regard to the geographical dynamics of production and work. We argue that a more effective line of explanation must relate urban growth directly to the economic geography of production and must explicitly deal with the complex recursive interactions between the location of firms and the movements of labor. In this context, we also offer a reinterpretation of the currently fashionable notions of creativity and the role of skilled labor in cities.},
	number = {2},
	journal = {{JOURNAL} {OF} {ECONOMIC} {GEOGRAPHY}},
	author = {M Storper and {AJ} Scott},
	month = mar,
	year = {2009},
	keywords = {agglomeration, economics, geographical economics, geography},
	pages = {147--167}
},

