},

@article{fujita_evolution_2010,
	title = {The Evolution of Spatial Economics: From Thunen to the New Economic Geography},
	volume = {61},
	issn = {1352-4739},
	shorttitle = {{THE} {EVOLUTION} {OF} {SPATIAL} {ECONOMICS}},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&colname=WOS&search_mode=CitingArticles&qid=10&SID=P1M6hL8JlLll8cb4F3b&page=4&doc=39},
	doi = {10.1111/j.1468-5876.2009.00504.x},
	abstract = {This paper presents a review of the evolution of spatial economics over the past two centuries. The focus is on the evolution of what I consider to be the most fundamental theory of spatial economics, i.e., general location theory. The paper starts with a review of Thunen (1826), and ends with a review of the New Economic Geography initiated by Paul Krugman in the early 1990s. It is shown that the study of general location theory has been successful at shedding light on many important features of actual spatial economies.},
	number = {1},
	journal = {Japanese Economic Review},
	author = {M Fujita},
	month = mar,
	year = {2010},
	pages = {1--32}
},

