@article{behrens_changes_2007,
	title = {Changes in transport and non-transport costs: Local vs global impacts in a spatial network},
	volume = {37},
	issn = {0166-0462},
	shorttitle = {Changes in transport and non-transport costs},
	url = {http://www.sciencedirect.com/science/article/B6V89-4PCPFBW-2/2/d0eac47c387a3c6c20178b6395e6d346},
	doi = {10.1016/j.regsciurbeco.2007.08.003},
	abstract = {We develop a multi-country {Dixit-Stiglitz} trade model and analyze how industry location and welfare respond to changes in: (i) transport frictions (e.g., infrastructure, transportation technology); and (ii) non-transport frictions (e.g., tariffs, standards and regulations). We show that changes in non-transport frictions, which are usually origin-destination specific, do not allow for any clear prediction as to changes in industry location and welfare; whereas changes in transport frictions, which are usually not origin-destination specific, may allow for such predictions. In particular, we show that reductions in transport frictions occurring at links around which the spatial network is locally a tree are Pareto welfare improving.},
	number = {6},
	journal = {Regional Science and Urban Economics},
	author = {Kristian Behrens and Andrea R. Lamorgese and Gianmarco {I.P.} Ottaviano and Takatoshi Tabuchi},
	month = nov,
	year = {2007},
	keywords = {economics, geography, localisation},
	pages = {625--648}
},

@article{overman_can_2004,
	title = {Can we learn anything from economic geography proper?},
	volume = {4},
	issn = {1468-2702},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&search_mode=GeneralSearch&qid=25&SID=X2JOjA9k2of6Gpplk7p&page=1&doc=1},
	doi = {10.1093/jnlecg/lbh028},
	abstract = {This paper considers the ways geographers (proper) and (geographical) economists approach the study of economic geography. It argues that there are two areas where the approach of the latter is more robust than the former. First, formal models identify which assumptions are crucial in obtaining a particular result and enforce internal consistency when moving from micro to macro behaviour. Second, empirical work tends to be more rigorous. There is much greater emphasis on identifying and testing refutable predictions from theory and on dealing with issues of observational equivalence. But any approach can be improved and so the paper also identifies ways in which geographical economists could learn from the direction taken by economic geographers proper.},
	number = {5},
	journal = {Journal of Economic Geography},
	author = {{HG} Overman},
	month = nov,
	year = {2004},
	keywords = {economics, geography},
	pages = {501--516}
},

@article{glaeser_complementarity_2010,
	title = {The Complementarity Between Cities and Skills},
	volume = {50},
	url = {http://dx.doi.org/10.1111/j.1467-9787.2009.00635.x},
	doi = {10.1111/j.1467-9787.2009.00635.x},
	abstract = {There is a strong connection between per-worker productivity and metropolitan area population, which is commonly interpreted as evidence for the existence of agglomeration economies. This correlation is particularly strong in cities with higher levels of skill and virtually nonexistent in less skilled metropolitan areas. This fact is particularly compatible with the view that urban density is important because proximity spreads knowledge, which either makes workers more skilled or entrepreneurs more productive. Bigger cities certainly attract more skilled workers, and there is some evidence suggesting that human capital accumulates more quickly in urban areas.},
	number = {1},
	journal = {Journal of Regional Science},
	author = {Edward L. Glaeser and Matthew G. Resseger},
	year = {2010},
	keywords = {agglomeration},
	pages = {221--244}
},

@book{brakman_new_2009,
	edition = {2},
	title = {The New Introduction to Geographical Economics},
	isbn = {0521698030},
	url = {http://www2.econ.uu.nl/users/marrewijk//newgeo/index.htm},
	publisher = {Cambridge University Press},
	author = {Steven Brakman and Harry Garretsen and Charles van Marrewijk},
	month = apr,
	year = {2009},
	keywords = {economics, geography},
	annote = {{{\textless}h2{\textgreater}A} first look at geography, trade and development{\textless}/h2{\textgreater}
{{\textless}p{\textgreater}First} thing that strikes me - p.16-17. {HDD} global production - the diversity of the 'value chain', more money made in the {US} though {SE} Asia is where most of the actual employment is, but wages are lower - the same applies for global food chains, doesn't it? If you did a map of the same thing, how would it turn out?{\textless}/p{\textgreater}
{{\textless}p{\textgreater}It} starts out with lots of empirical data - which is nice. The ultimate conclusion: the distribution of economic activity across space is:{\textless}/p{\textgreater}
{{\textless}ol{\textgreater}{\textless}li{\textgreater}Uneven{\textless}/li{\textgreater}}
{{\textless}li{\textgreater}Fractal} - "the phenomenon repeats itself at various levels of aggregation." [26]{\textless}/li{\textgreater}
{{\textless}/ol{\textgreater}{\textless}p{\textgreater}This} distribution across space appears to follow the rank size distribution. So - perhaps similar economic forces are at play. This is what I want to be integrating into my work of course - how these forces impact on the direction geographies of food will take, under different social technologies.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"Finding} a common framework to get a better grip on a plethora of data is what makes economic models useful. That being said, common framework should not become a straightjacket." [27]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} key question we're talking about here is the {\textless}strong{\textgreater}location of economic activity. {{\textless}/strong{\textgreater}(Oo,} that's the name of the Hoover book!) They want a theory in which "the geography of the economy itself can be derived from the behaviour of economic agents." [32]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Many} theories - "typically assume as given what has to be explained from the underlying behaviour of the economic agents, namely the spatial structure of economic activity." [33]{\textless}/p{\textgreater}
{{\textless}h2{\textgreater}Geography} and economic theory{\textless}/h2{\textgreater}
{{\textless}h3{\textgreater}Regional} economics \&amp; economic geography: examining different things...{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Regional} econs: based on {\textless}strong{\textgreater}neoclassical economic theory - {\textless}/strong{\textgreater}successor to German location economics tradition{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Econ} Geog: eclectic, empirically focused - not just economics, but nicking bits from e.g. sociology, regulation theory{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}A} definition of agglomeration for you: "the decline in average costs as more production occurs within a specified geographical area" {(Anas,} Arnott, Small 1998 - a paper.) 35{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Which} they also call 'increasing returns to scale. Do they mean increasing returns to geographical scale? I'm a little unclear.{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}Monocentric} city model: von Thunen 1826 stylee{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Featureless} plane{\textless}/li{\textgreater}
{{\textless}li{\textgreater}One} city (taking the location of the city as a given){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Outside} city - farmers grow crops, which they must sell in the city{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Crops:} transport costs differ, market prices differ{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}Q:} how do farmers locate themselves across the plane?{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Farmers:} want to be as close as possible to minimise transport costs - leads to higher land rents through more demand{\textless}/li{\textgreater}
{{\textless}li{\textgreater}So} - land rent / transport costs trade-off{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}"Von} Thunen showed that competition for locations ensures that the resulting equilibrium allocation of land among the farmers will be efficient." [35]{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Better} crops (lower cost e.g. transport, higher market price) means better bidding for land - they end up closer to the city. {\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}So} - do any farmers actually move about that much? How do they make decisions? Wouldn't a farmer renting land make decisions on what to grow rather than shifting farm? Does this end up being the same conclusion?{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Urban} version - Alonso 1964.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"The} efficiency of land allocation in the monocentric model hinges on the assumption that there are no externalities of location." [36]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Noted:} link between decentralisation of cities and drop in transport costs over the 20th century.{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}Terminology} of scale economies{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}The} basic point of course - increasing scale of production = decrease in average costs. = downward sloping {AC} curve.{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}{\textless}strong{\textgreater}Internal} vs external {{\textless}/strong{\textgreater}EoS} - seem to come from Tibor Scitovsky 1954{\textless}br {/{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}Internal} - {AC} decrease comes from increasing production within the firm itself{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"The} market structure underlying internal scale economies, typically used in the geographical economics literature, must necessarily be one of {\textless}strong{\textgreater}imperfect competition{\textless}/strong{\textgreater}, as internal economies of scale imply market power." [38]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}External} - {AC} decrease comes from output increase at industry level "making average costs per unit a function of industry-wide output." [38]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}{\textless}strong{\textgreater}Pure} vs pecuniary external economies{\textless}/strong{\textgreater} 
{\textless}ul{\textgreater}{\textless}li{\textgreater}{\textless}strong{\textgreater}pure {\textless}/strong{\textgreater}(or technological) external economies - "an increase in industry-wide output alters the technological relationship between inputs and output for each firm. It therefore has an impact on the firm's production function." {\textless}br {/{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}A} Marshallian example: information spillovers - general increase in output increases the general local stock of knowledge. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}Markets} affected by pure externalities can still be perfectly competitive, since individiual firms' size does not matter. {(Hmm} - surely some cases where it would?){\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}{\textless}strong{\textgreater}Pecuniary{\textless}/strong{\textgreater}} - "transmitted through the market by price effects for the individual firm"; e.g.            
{{\textless}ul{\textgreater}{\textless}li{\textgreater}From} wikipedia - influence of new comers in city driving up house-prices. A purely price effect on others in the city. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}Marshallian} ones - large local market for specialised inputs, labour market pooling. Both are the result of new firms coming into an area - but importantly {\textless}strong{\textgreater}do not{\textless}/strong{\textgreater} affect the actual tech relationship between inputs and output.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}These} appear in the geogecon lit through a {\textless}strong{\textgreater}love-of-variety{\textless}/strong{\textgreater} effect in a large local market. {(Q:} through {CES?)} Utility goes {\textasciicircum} with variety of manufactures consumed.[39]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"The} price effects crucial to pecuniary externalities can come about only with imperfect competition." I think I saw why once, but right now...{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}These} distinctions seem somewhat vague to me - surely there are situations where production 'functions' will change as a result of all kinds of externality? Will have to think this one through a little more mefinks. And I'm still pretty unclear how love-of-variety = pecuniary externality. Huh?{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Mentions} negative externalities - e.g. I imagine one firm increases production, increases costs for others coz of overall increase in demand.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}They} characterise {MAR} vs Jacobs externalities as "sector specific" and "city specific" spillovers. The latter spanning many sectors - diverse spillovers. Also: localisation economies vs urbanisation economies - same thing.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}New} term: {{\textless}strong{\textgreater}Porter} externality. {{\textless}/strong{\textgreater}A} little unclear on what it is - competitive externalities of some sort.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Two} surveys of theories of agglomeration: Fujita and Thisse, 1996, 2002.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Strategic} behaviour in firm's spatial competition not taken into account in this book. {"Firms} take each other's (pricing) behaviour as given." [43] But then - how do they {\textless}em{\textgreater}know{\textless}/em{\textgreater} what prices those firms have?{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Another} reason for agglomeration (surely a very important one) - physical geography. E.g. a natural harbour.{\textless}/p{\textgreater}
{\textless}p{\textgreater}\&gt;\&gt; on to note 2 for regional economics...{\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}},
	annote = {{{\textless}h2{\textgreater}Agglomeration{\textless}/h2{\textgreater}}
{{\textless}p{\textgreater}Going} though and nicking bits to nail down a definition of agglomeration I can start to use for the modelling. Thus -{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}Chapter} 7: cities, economies of scale, urban systems, Zipf's law{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}"Congestion"} - a useful idea. "a catchall phrase for many drawbacks associated with urban agglomeration, referring to limited physical space, heavy usage of roads, communication channels and storage facilities, limited local resources (such as water for cooling processes), and environmental pollution." [273]
{{\textless}ul{\textgreater}{\textless}li{\textgreater}They} note it's notoriously very hard to measure, but in an abstract model (and if I can succeed with the density function idea) it'd be quite easy to add a simple negative externality associated with clustering (beyond rent prices.){\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Modern} urban economics (there's that phrase again, cf. Glaeser) - "turns mainly to increasing returns to scale to explain the existence of cities." [275] + solid microeconomic foundation. {(BLech!){\textless}/li{\textgreater}}
{{\textless}li{\textgreater}They} note the main categories are not far off Marshall's original formulation. 3 main sources:
{\textless}ul{\textgreater}{\textless}li{\textgreater}'information or knowledge sharing'{\textless}/li{\textgreater}
{\textless}li{\textgreater}labour market pooling{\textless}/li{\textgreater}
{\textless}li{\textgreater}the sharing of (specialised) inputs.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}They} then list addition ones taken from Rosenthal and Strange 2004 tab2:
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Natural} advantages (though cf. Glaeser, not actually an agglom econ.){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Home} market effects at the industry level{\textless}/li{\textgreater}
{{\textless}li{\textgreater}'Consumption} externalities': 'various city-specific amenities' [276] making particular places attractive; feedback relation with the level of human capital. E.g. cities in Germany that started out with a high share of skilled labour diverged in growth from those that didn't. [279] "people in their dual capacity as workers and consumers are nowadays probably as important to city growth and innovation as firms are." [277]
{{\textless}ul{\textgreater}{\textless}li{\textgreater}In} what ways, exactly? (and what's the simplest I should consider?){\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Rent-seeking:} may lead to too-large cities. Cf. my point about political capitals in the Glaeser notes; cf. what a political centre looks like with little other industry - lobbyists, coffee shops, barren...{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}They} note there's a pretty large empirical black hole over all of this. Plenty we don't know yet. [276]
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Much} of it cannot be observed directly{\textless}/li{\textgreater}
{\textless}li{\textgreater}"model-based testable hypotheses in this literature are subject to observational equivalence (it is often  difficult, or even impossible, to discriminate between the different sources of scale economies.)" [276]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}Duranton} \&amp; Puga 2004: mechanisms of agglom different from sources.
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Picture:} agglom gives a match between firms and inputs; label them workers, intermediates, or ideas.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Depending} on label, "a matching model of urban agglom economies could be presented as a formalisation of either one of Marshall's 3 basic {\textless}em{\textgreater}sources{\textless}/em{\textgreater} of agglomecons even though it captures a single {\textless}em{\textgreater}mechanism{\textless}/em{\textgreater}." [direct quote from {D+P]{\textless}/li{\textgreater}}
{{\textless}li{\textgreater}Their} 3 basic mechanisms:
{{\textless}ul{\textgreater}{\textless}li{\textgreater}"Sharing":} indivisibilities e.g. an opera house feasible only in large city.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Matching":} quality of match between worker and employer (so elasticity of labour substitution then, presumably...?) {"Larger} cities offer a higher probability of a successful match."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Learning":} face to face contact; better in larger cities, again. {\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}They} think in practice, the distinction is more blurred than this. I wonder what I think?{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}Scope:} "the extent or strength underlying economic force." [sic] [276] again from Rosenthal + Strange tab 1{\textless}br {/{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}Industrial} scope: does it extend across all sectors? cf. localisation and urbanisation economies.[277]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Temporal} scope: path dependency? Activities at time t affect t+1?{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Geographic} scope: "is proximity (to other cities) or density (within cities) good for urban development in terms of, for instance, wage rates or the growth rate of employment?"
{{\textless}ul{\textgreater}{\textless}li{\textgreater}From} Ch 5 section 5.5.: neoclassical trade theory - "no foundation for a spatial wage structure."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}I} think I need to come back to this ch on spatial wage structure - not so vital for now.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Organisation} and business culture / competitiveness scope": {"Does} competition increase productivity? This issue touches upon the distinction between sector-specific and city-specific externalities." {[MAR} vs Jacobs] "better for sectoral growth if the size of individual establishments is smaller." Why?{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}"Cities} with higher levels of human capital have higher wages and income levels." Duh. [278]{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}They} don't cover the whole lit, concentrating on industrial and competitiveness scope studies.{\textless}/p{\textgreater}
{\textless}p{\textgreater}btw: using {MAR} vs Jacobs externalities - from Glaeser et al 1992.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}So} to recap:{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}MAR} externalities ("which feature in much of modern growth theory, knowledge spillovers occur between firms that belong to the same industry. In this case, city growth is fostered by specialisation, and so localisation externalities are the main driving force." [280]){\textless}/li{\textgreater}
{\textless}li{\textgreater}cf. Jacobs - not industry-specific. Diversity = key.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Glaeser} et al: Jacobs most important. Others find {MAR} for e.g. high-tech industries. {(Huh?){\textless}/li{\textgreater}}
{{\textless}li{\textgreater}Glaeser} 2000: "for the moment, the role of concentration and diversity does not seem to have been resolved by the literature." [280-1]
{{\textless}ul{\textgreater}{\textless}li{\textgreater}City} size seems to matter more for productivity than specialisation {[I} can think of several reasons why...]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Notes} the Krugman feedback: {"In} the core model of geogecons, firms group together in a city because local demand is high, and demand is high because firms have decided to produce in that city. What matter is that te positive externality is assocd with the number of firms (and their workers) in the city and its surrounding cities and not with whether or not firms specialise in the production of the same type of goods. The core model is therefore a model in which, if anything, urbanisation and not localisation exts are present. There is no advantage is cities being specialised; only size as such matters." [281]
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Presumably} because: core model firms all produce unique product, with defined elasticity of substitution. So, no specialisation and love of variety underpins it. That seems to sooooo miss the point of Jacobs' work.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}They} note: all the focus is on {\textless}strong{\textgreater}positive{\textless}/strong{\textgreater} externalities; spreading forces not analysed directly. {(E.g.} I suppose, land rent - an equilibriating force.) They also mention 'the need for city firms to serve non-city markets' and congestion.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}A} reason they give is interesting for my stuff, where I'm trying to get right outside of city or region: the empirical focus has been on individual cities, not the relationship between them. {"The} nationwide space, which includes {\textless}em{\textgreater}both{\textless}/em{\textgreater} cities and rural areas, is simply not a prime object of research in urban economics."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}They} then move onto urban systems. Weird. So - the closest we have to a full equilibrium model is... Krugman? Hmm.{\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}},
	annote = {{{\textless}h2{\textgreater}Regional} economics{\textless}/h2{\textgreater}
{{\textless}p{\textgreater}Starting} with von Thunen, Launhardt, Weber (optimal location and plant size for manufacturing firms), Christaller and Losch.{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}Central} place theory -{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Shows} "that Different points or locations on the economic landscape have different levels of centrality and that good services are efficiently provided on a {\textless}em{\textgreater}hierarchical {\textless}/em{\textgreater}basis." {(Mulligan} 1984 in this book p.44){\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}Briefly} -{\textless}/p{\textgreater}
{\textless}ul{\textgreater}{\textless}li{\textgreater}even dist of identical consumers across a homog plane{\textless}/li{\textgreater}
{\textless}li{\textgreater}centrality determined by {\textless}strong{\textgreater}internal increasing returns to scale{\textless}/strong{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Location} important coz consumers incur transport costs, which they try to minimise.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}For} things with limited inc rets to scale - gonna be more of em. E.g. breadmaking in villages. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}The} hierarchy - cities do all functions e.g. {TVs} and bread; villages just bread.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}p{\textgreater}"central place theory, especially the graphical version still found in most introductory textbooks on economic geography, is indeed more a descriptive story - or an exercise in geometry - than a causal model." [46]{\textless}/p{\textgreater}
{\textless}p{\textgreater}\&gt; no theory of consumer or firm behaviour, no demand curve derived - just assumed. That sort of thing. Generally a bit lacking.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Other} models mentioned as having no connection to underlying behaviour - gravity models and rank-size distribution equations. {(But} perhaps their job isn't to explain?){\textless}/p{\textgreater}
{{\textless}p{\textgreater}All} this stuff also appears to miss feedbacks between demand and {supply.E.g.} "demand is high where production is located as a result of the purchasing power of the workers making production at that location possible." [49]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Good} quote: {"The} theoretical approaches, like central place theory and the more empirically inspired approaches, like the market potential analysis, deal with important aspects of the spatial organisation of economic activity. The framework of analysis by and large does not, however, meet the standards of mainstream economic theory, which requires the conclusions to be based on the actions and interactions of individual economic agents in the market place. This calls for the analysis of individual consumer and producer behaviour, market structure, and the resulting equilbria." [50]{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}The} spatial impossibility theorem{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}"The} standard general equilibrium framework will not work if we want geogaphy or space to matter." {(David} Starrett 1978 showed this.) [51]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}This} is the {\textless}strong{\textgreater}backyard capitalism {\textless}/strong{\textgreater}thesis - transport costs can be avoided if production and consumption happen on the same spot. {"Each} location will prefer aukarky to save on transportation costs." [52]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Returns} to scale is clearly an important part of the story here. Divisibility is also important. One indivisibility - operations must take up space.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"Without} recognising indivisibilities - in human person, in residences, plants, equipment, and in transportation - location patterns, down to those of the smallest village, {\textless}em{\textgreater}cannot {\textless}/em{\textgreater}be understood." Tjalling Koopmans 1957:154 at p.51{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Fujita} / Thisse 2002 chap 4: inc returns - transport costs = "the fundamental trade-off for a spatial economy." [52]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"With} increasing returns but without transport costs, firms may find it profitable to produce at a single plant, but they do not care about the location of this plant. // In the absence of increasing returns (or non-homogenous space) but with transport costs, we will thus end up in a situation of backyard capitalism." [52]{\textless}/p{\textgreater}
{\textless}p{\textgreater}"... because it turned out to be difficult to combine transportation costs, increasing returns to scale, and imperfect competition in a general equilibrium framework, it took quite some time from Koopmans (1957) via Starrett (1978) to arrive at the first geographical economics model, by Krugman (1991a){\textless}/p{\textgreater}
{{\textless}h3{\textgreater}International} trade theory{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}"The} core model of geographical economics has its roots firmly in international trade theory." [53] An extension of Krugman's own 'new trade theory' 79-80. So - looking at the geog content of these two papers.{\textless}/p{\textgreater}
{\textless}ul{\textgreater}{\textless}li{\textgreater}neoclassical trade theory - trade flows determined by comparative advantage - either tech differences {(Ricardian)} or factor endowments {(Heckscher,} Olin, Samuelson.){\textless}br /{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}---{\textless}/li{\textgreater}
{\textless}li{\textgreater}2x2x2 model: 2 goods, 2 countries, 2 factors of production{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Goods:} clothes and machinery{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Factors} - high and low skill labour{\textless}/li{\textgreater}
{{\textless}li{\textgreater}North:} relatively well-endowed with high-skill{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Machinery} production: relatively highly skilled (but both need some of each.){\textless}/li{\textgreater}
{{\textless}li{\textgreater}N+S} consumers - identical preferences, consume both goods.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Result:} partial specialisation, equalisation of factor prices - that is, one high-skill wage, one low-skill wage.{\textless}/li{\textgreater}
{\textless}li{\textgreater}---{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Assumptions:} perfect competition, homogenous goods, constant {RtScale,} no transport costs assoc'd with trade of goods; mobility of factors of prod between industries but {NOT} countries.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}So} - very at odds with what we've said so far about regional econs - esp {RtScale.{\textless}/li{\textgreater}}
{{\textless}li{\textgreater}Empirical} evidence: {"Although} there is some disagreement, the general consensus seems to be that relatively strong {\textless}em{\textgreater}additional{\textless}strong{\textgreater} {\textless}/strong{\textgreater}{\textless}/em{\textgreater}assumptions are needed to close the gap between the neoclassical theory and the data. In any event, the four implications of the factor abundance model [see 56] are not convincingly substantiated by the evidence." [57]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}{\textless}strong{\textgreater}First} nature {\textless}/strong{\textgreater}and {\textless}strong{\textgreater}second nature {\textless}/strong{\textgreater}of econs of location {(Krugman} 1993b)        
{{\textless}ul{\textgreater}{\textless}li{\textgreater}First} nature - e.g. where the mines are, the river is, the natural port is.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Second} - some endogenous result - e.g. a labour market. Could be used as given (e.g. in model above) but better to deduce as part of model -{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Want} to show "how the relevance of location follows from the decisions made by economic agents and their interactions and not (only) from some exogenous difference in factor endowments." [55]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"The} endogenisation of location decisions is needed to produce agglomeration of economic activity. Differences in factor endowments cannot imply a core-periphery pattern of production; they just lead to specialisation (as opposed to agglomeration.)" ibid{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}p{\textgreater}of course, first nature geog does, in fact, explain a lot of economic differences. This is one of Sachs' big things, apparently. See p57.and ch.10.{\textless}/p{\textgreater}
{\textless}h3{\textgreater}specific factors model -{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}They} use this to illustrate limited role of geog in neoclassical trade theory. [p.58]{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}One} factor is mobile, the other not.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Goods} require a mix of the mobile factor and a specific immobile one (land or sector-specific capital.){\textless}/li{\textgreater}
{{\textless}li{\textgreater}With} predictable results... but again, decision on immobile factors is given.{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}This,} like with others then - the equilibrium is the result of these exogenous givens, not an internal model dynamic flowing from agent behaviour. {(Which} may be fair enough, of course...) Also, no core-periphery equilibrium possible.{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}New} trade theory{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}"The} reason for trade between countries in new trade theory does not depend on comparative advantage. In fact, Krugman (1979/80) has developed a (by now standard) model in which countries engage in welfare-enhancing trade even when there is no comparative advantage whatsoever."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Some} problems it addresses -{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}A} big chunk of international trade = between countries with similar factor endowments.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}This} is not (as neoclassical predicts) intra-industry, but inter-industry - e.g. import and export of cars for cars.{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}h3{\textgreater}Krugman} 1979:{\textless}/h3{\textgreater}
{\textless}ul{\textgreater}{\textless}li{\textgreater}2 countries of equal market size - same endowments, and use the same technology{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Both} have 1 immobile car-producing firm.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}In} factor abundance model, these countries wouldn't trade at all{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Inc} {RtS} for each type of car.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}In} autarky, firms produce {A,B,C} cars in West \&amp; {X,Y,Z} cars in East{\textless}/li{\textgreater}
{\textless}li{\textgreater} - which is one industry producing six types / varieties of car{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Consumers/workers} in West and East - immobile, evenly distributed, identical preferences{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Cars:} imperfect substitutes{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Consumers:} variety lovers{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}So} - internal economies of scale in the firms + love-of-variety effect = how we get to a rationale for trade: {"Moving} from autarky to free trade these two assumptions ensure that trade will take place and is welfare-improving." [60]{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}So:} easy enough to picture that {\textless}strong{\textgreater}enlarging your market means getting further along your increasing returns curve{\textless}/strong{\textgreater} - a bigger factor and selling market. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}Prices} per variety will decrease too{\textless}/li{\textgreater}
{{\textless}li{\textgreater}But:} total number of varieties must {\textless}strong{\textgreater}decrease{\textless}/strong{\textgreater}. Why?       
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Total} {(E+W)} endowments and total market size are {\textless}strong{\textgreater}fixed{\textless}/strong{\textgreater} - trade just opens them up.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Which} means you cannot simultaneously increase production of {\textless}strong{\textgreater}all {\textless}/strong{\textgreater}six varieties. {\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Implications:}       
{{\textless}ul{\textgreater}{\textless}li{\textgreater}The} decrease in prices through econs of scale = real wage increase for everyone{\textless}/li{\textgreater}
{{\textless}li{\textgreater}After} trade, consumers can choose from 4 rather than 3 varieties - inc welfare through love-of-variety{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}But} inc {RtS} implies imperfect competition. Krugman built on {Dixit-Stiglitz} 77.{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}New} trade theory \&amp; external economies{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Example:} {PC} industry - pure external economies of scale, through information spillovers as the sector grows. {\textless}/li{\textgreater}
{\textless}li{\textgreater}2 countries - consumers have identical preferences{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"This} implies not only that average costs per {PC} for each firm are a decreasing function of the {\textless}em{\textgreater}industry{\textless}/em{\textgreater} output, but also that we can still use perfect competition." [61]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}No} advantage to being large - so many small firms producing at {AC} per unit.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}You} may get a {\textless}strong{\textgreater}lock-in effect:{\textless}/strong{\textgreater} 
{{\textless}ul{\textgreater}{\textless}li{\textgreater}As} with internal {EoS,} you may get intra-industry trade - both countries producing and exporting {PC} varieties. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}With} {\textless}strong{\textgreater}external{\textless}/strong{\textgreater} {EoS} - can have equilibrium where {\textless}strong{\textgreater}1 country produces total world demand{\textless}/strong{\textgreater}. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}If,} for e.g. some historical reason the {PC} industry establishes itself in one country, external economies may turn this into a lasting equilibrium. {(Isn't} that exog...?){\textless}/li{\textgreater}
{{\textless}li{\textgreater}{\textless}strong{\textgreater}Initial} conditions {\textless}/strong{\textgreater}can determine the stable outcome{\textless}/li{\textgreater}
{{\textless}li{\textgreater}The} resulting equilibrium {\textless}strong{\textgreater}may be inefficient{\textless}/strong{\textgreater}{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}{\textless}strong{\textgreater}What} would a bad equilibrium look like?{\textless}/strong{\textgreater} 
{{\textless}ul{\textgreater}{\textless}li{\textgreater}For} me, I can grasp this best by thinking that a country with lock-in has an imperfect competition market advantage - the spillover effects means it can produce more cheaply. E.g. if A can produce for £750, but the market will bear £1000, they can charge that - if B can't enter the market at that price. So as long as they keep their price below B's {AC,} they have the market cornered. {(Is} that what happens though? Many markets are hugely segregated...){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Note:} Seth Bullock has worked on segregated markets - http://eprints.ecs.soton.ac.uk/13380/{\textless}/li{\textgreater}
{{\textless}li{\textgreater}In} fact, yes - country A would be able to take into account consumer's travel and other costs and perhaps segregate the market price based on differences in demand and demand elasticity{\textless}/li{\textgreater}
{{\textless}li{\textgreater}{\textless}strong{\textgreater}But} - {\textless}/strong{\textgreater}isn't this just exactly the same as internal economies of scale, except those {EoS} are internal to a country rather than a firm?{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}h3{\textgreater}{\textless}strong{\textgreater}Krugman} 1980{\textless}/strong{\textgreater}{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}A} crucial step from Krugman 79 to get us closer to the core geographical economics model.{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Somehow,} going from autarky to trade does {\textless}strong{\textgreater}not{\textless}/strong{\textgreater} lead to an increase in production despite increasing returns to scale at the firm {level.Huh?{\textless}/li{\textgreater}}
{{\textless}li{\textgreater}"The} gains from trade are now completely due to the love-of-variety effect, as consumers can choose between more varieties under trade than autarky." [63] So - it's a welfare gain? {(Prices} don't change either.) {"The} core model of geog econs coincides with Krugman (80) on this important issue."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Trade} between nations {\textless}strong{\textgreater}incurs transport costs{\textless}/strong{\textgreater} - yay, geography!{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Demand} per variety is no longer symmetric as countries differ in market size."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Combine} uneven market sizes with transport costs: countries will produce varieties for which demand is relatively high in their own country - minimising transport costs.{\textless}/li{\textgreater}
{\textless}li{\textgreater}leads to the {\textless}strong{\textgreater}home market effect{\textless}/strong{\textgreater}: Krugman - "countries will tend to export those kind of products for which they have relatively large home demand. Notice that this argument is wholly dependent on increasing returns; in a world of diminishing returns, strong domestic demand for a good will tend to make it an import rather than an export." {[Krugman} 80 p.955 at p.64]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Davis} and Weinstein tested for home market effect - they don't report the result.{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}Note} differences to core geog econ model:{\textless}/p{\textgreater}
{{\textless}ol{\textgreater}{\textless}li{\textgreater}Neither} firms nor workers decide anything about location; "given their (exogenous) location, firms make a decision only about the varieties they want to produce." [64]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Core-periphery} equilibria are not possible because the concentration of demand in the first country, say for x varieties, is mirrored" by 1-x in the other country. Gosh they say that in a wordy way.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"The} allocation of the market size for the vareities is not an outcome of the model but is simply given (income is therefore also given."{\textless}/li{\textgreater}
{\textless}/ol{\textgreater}{\textless}p{\textgreater}"agglomerations arise but only through the magnification of initial region size asymmetries." [67-8]{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}Krugman} and Venables (1990){\textless}/h3{\textgreater}
{{\textless}p{\textgreater}Won't} spend a lot of time on this one: the key points -{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}They're} examining an exogenously defined core-periphery model, to see what happens when transport costs change.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Transport} costs are used as a proxy for increasing integration (as they drop, you move from autarky.){\textless}/li{\textgreater}
{{\textless}li{\textgreater}As} they drop, there's a period where the richer country gets a larger share of world production (firms are allowed to enter and exit the market){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Why?} Higher labour market costs are offset by lower transport costs and the larger market{\textless}/li{\textgreater}
{{\textless}li{\textgreater}As} transport costs drop more, the advantage of producing in the larger market declines - so things even out again.{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}That} wasn't a bad summary! The point, really, is pocketbook considerations of firms, and the effect of having access to a market (and presumably the effect that has on your {RtS} and subsequent pricing.) Also that agglomeration is a dynamic part of the model, not exogenously imposed (if one discounts market size.){\textless}/p{\textgreater}
{{\textless}p{\textgreater}Actually,} that's why they say its not quite a "full-fledged geographical economics model" - the source of core-periphery is not derived from the model. {(That's} worth noting: they're claiming that a full-fledged model has to explain these things dynamically, endogenously. What things am I trying to explain or examine endogenously?){\textless}/p{\textgreater}
{{\textless}p{\textgreater}{\textless}strong{\textgreater}The} core model - adds endogenisation of market size and worker mobility to this model. {\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} non-linear, U-shaped pattern of a graph of changing transport costs crops up in much of geog econ.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Key} difference between new trade theory and geog econ: endogenising the size of the market. {(So} they claim.){\textless}/p{\textgreater}
{{\textless}p{\textgreater}Head} and Mayer's (2004a) {\textless}strong{\textgreater}five essential ingredients to geog econs{\textless}/strong{\textgreater}:{\textless}/p{\textgreater}
{{\textless}ol{\textgreater}{\textless}li{\textgreater}Inc} {RtS} - internal to firm{\textless}/li{\textgreater}
{\textless}li{\textgreater}imperfect competition (implied by \#1...){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Positive} transport / trade costs{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Endogenous} firm locations{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Endogenous} location of demand - either through mobile workers {(Krugman} 91) or "firms using their sector output as intermediate inputs" {(Venables} 96; Krugman \&amp; Venables 95; Ch.4.) [67]{\textless}/li{\textgreater}
{{\textless}/ol{\textgreater}{\textless}p{\textgreater}"The} key innovation of {NEG} relative to new trade theory is assumption [5]. Without 5 symmetric initial conditions can be expected to lead to symmetric outcomes. With all 5 assumptions, initial symmetry can be broken and agglomerations can form through a process of circular causation." [68]{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater}{\textless}strong{\textgreater}{\textless}br /{\textgreater}{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}},
	annote = {{{\textless}h2{\textgreater}The} core model: demand structure{\textless}/h2{\textgreater}
{{\textless}h3{\textgreater}Spending} on food and manufactures (callout a){\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Two} goods: manuf M, food F{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Price} index of M = I - will come back to this. Needs to represent all varieties{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Consumers} earn income Y - spends on a mix of M and F{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Utility} is a Cobb Douglas U = F{\textasciicircum}(1-delta) * M{\textasciicircum}delta [eq.3.1]{\textless}br {/{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}Remember:} power summing to 1 means if F and M increase by 20\%, so does utility{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Budget} constraint: want to spend up to Y - {\textless}br {/{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}So} Y must equal F + {(I*M)} [eq.3.2]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}So} - F, which is the numeraire, plus the price index of M. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}Which} is why there's no actual price of food in the equation, but there is a price of manufactures{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"To} decide on the optimal allocation of income over the purchase of food and manufactures, the consumer now has to solve a simple optimisation problem, namely - {\textless}/li{\textgreater}
{\textless}li{\textgreater}maximise utility as given in equation 3.1, subject to the budget constraint of equation 3.2." [90]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}This} is a {\textless}strong{\textgreater}constrained maximum problem{\textless}/strong{\textgreater} I think - and there's a derivation using the Lagrangean multiplier on p.91. Same thing used in Fundamental Methods pp.349ish. So - the utility function is constrained by budget. Doing as I'm told by the book, I'll come back to the technical derivations and get the basic gist first...!{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}Anyway,} maximise 3.1 subject to constraining by 3.2, you get:{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}F} = (1 - {delta)Y;} {IM} = delta * Y{\textless}/li{\textgreater}
{\textless}li{\textgreater} - which is handily tractable, isn't it? {"It} is optimal for the consumer to spend a fraction, (1-delta), on food, and a fraction, delta, of income on manufactures.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}So} delta is "the fraction of income spent on manufactures." [90]{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}h3{\textgreater}Spending} on manufacturing varieties (callout b){\textless}/h3{\textgreater}
{{\textless}p{\textgreater}How} is delta allocated among the different varieties? {"We} have to optimally allocate spending between the consumption of a number of goods that can be consumed." [91]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}So:} we need to define how preferences for M depend on particular varieties.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}{\textless}strong{\textgreater}Roll} out the {CES} function from Dixit Stiglitz:{\textless}/strong{\textgreater}{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Ci} = level of consumption of variety i{\textless}/li{\textgreater}
{{\textless}li{\textgreater}N} = total number of varieties{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}Go} see equation 3.4 - N variety {CES} equation with rho being the love of variety effect. What does Krugman call this? Oh - its elasticity of substitution of course. The more elastic, presumably, the more people don't mind what they get, the more manufactures become homogenous (perfect substitution.){\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} {CES} here is also slightly different from Krugman's - have to wait and see if that comes up later I guess.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}It} ends up with N{\textasciicircum}(1/p)-1 * Nc; 0 \&lt; p \&lt; 1 [p is rho] by assuming demand is entering symmetrically for all goods.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Quick} mathstruggle note: just spent yonks trying to work out how{\textless}/p{\textgreater}
{\textless}ul{\textgreater}{\textless}li{\textgreater}x * y = x{\textasciicircum}-1 * (yx){\textless}/li{\textgreater}
{{\textless}li{\textgreater}It} does work, and in seeking an intuitive answer, I think I sort of have one - you're removing a multiple of x from the first term, so you can add one to the last term. I've checked the sums, it definitely works! {\textless}/li{\textgreater}
{{\textless}li{\textgreater}I'm} just a little unclear why they needed to do it - perhaps that will become apparent.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}p{\textgreater}\&gt; {"The} term N{\textasciicircum}(1/p)-1 represents a bonus for large markets - hence the term 'love of variety effect.' In this sense, and increase in the extent of the market, which increases the number of varieties N the consumer can choose from, more than proportionally increases utility." [93]{\textless}/p{\textgreater}
{\textless}h4{\textgreater}box 3.2: Dixit Stiglitz monopolistic competition{\textless}/h4{\textgreater}
{{\textless}p{\textgreater}This} is quite weird, actually. So we know that they use a {CES} to make some "heroic assumptions concerning symmetry of new varieties and the structural form, which allowed for an elegant and consistent way to model production... without getting bogged down in a taxonomy of oligopoly models." [93]  They note the messy history of imperfect competition research.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Why} weird? How this meant the {DXS} model became so universally popular - "the new standard for modeling monopolistic competition." Take this sentence:{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"In} international trade theory, the introduction of the monopolistic competition model enabled international economists to explain and understand intra-industry trade, which until then had been empirically observed but never satisfactorily explained. {(Krugman} 1979/80) In industrial organisation, it helped to get rid of many ad hoc assumptions, which hampered the development of many industrial organisation models." [93]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}But} how is it actually any explanation? The criteria for validity seems bizarre to me - if you can build endogenous dynamics into the model that somehow represent some empirical aspect of the world, you're explaining it.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}I} can't help but wonder: was it so popular because it opened up a rich new seam of academic work and funding? It's a bit of a mystery to me.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Again:} the very different ways this model might map to the world in comparison to an {ABM?} The latter would be accused of adhocery, but these equations seem so colossally distant from reality. Christ, maybe Scott Moss is right!{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Anyhoo,} back to the sums...{\textless}/p{\textgreater}
{\textless}p{\textgreater}---{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}How} does the consumer allocate spending on manuf over the various varieties? [94]{\textless}/h3{\textgreater}
{\textless}ul{\textgreater}{\textless}li{\textgreater}pi = price of variety i for i = 1 to N{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Naturally"} - funds {\textless}strong{\textgreater}p{\textless}/strong{\textgreater}i{\textless}strong{\textgreater}c{\textless}/strong{\textgreater}i spent on variety i can't be spent on variety j - there's a budget constraint for spending on manuf:sum of all{\textless}strong{\textgreater}{\textless}strong{\textgreater} {\textless}/strong{\textgreater} {\textless}/strong{\textgreater}{\textless}strong{\textgreater}p{\textless}/strong{\textgreater}i{\textless}strong{\textgreater}c{\textless}/strong{\textgreater}i{\textless}strong{\textgreater} {\textless}/strong{\textgreater}{\textless}strong{\textgreater} {\textless}/strong{\textgreater}{\textless}strong{\textgreater} {\textless}/strong{\textgreater} = delta Y [eq.94] (as we saw above.){\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}},
	annote = {{{\textless}h2{\textgreater}The} core model: introduction{\textless}/h2{\textgreater}
{{\textless}p{\textgreater}Ohlin} 1933: all trade theory is asking "who produces what, where and why?" [81] But trade theory followed a different path to reg/urb econs.{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Trade} theorists: how do market structure, production techniques and consumer behaviour interact? {"The} resulting factor and commodity prices determine the pattern of international trade flows." Location plays only an exogenous role at best.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Reg/urb} econs: take market structure and prices as given - then seeks the most efficient allocation of space. {"The} underlying behaviour of consumers and producers, central to trade theory, is less important." [81]{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}These} two combined in geog econ with Krugman's small {GE} model. Results are non-linear:{\textless}/p{\textgreater}
{\textless}p{\textgreater}"this means, for example, that the location decision of a single producer might not change the spatial pattern of production, but it {\textless}em{\textgreater}could{\textless}/em{\textgreater} have dramatic or 'catastropic' [chaos] consequences." [82]{\textless}/p{\textgreater}
{\textless}p{\textgreater}- possible it might trigger a feedback.{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}An} example to get us warmed up -{\textless}/h3{\textgreater}
{\textless}ul{\textgreater}{\textless}li{\textgreater}2 regions, 2 sectors: agri, manuf{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Manuf} = a variety of products under internal economies of scale - {AC} falls as firms expand production level; "as a result, each firm produces only one variety." [83]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Firms:} can decide which region to produce in. {"This} location decision essentially differentiates the example from new trade theory."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}In} this example: total demand is exogenous: assume each firm sells -             
{\textless}ul{\textgreater}{\textless}li{\textgreater}4 units  to workers{\textless}/li{\textgreater}
{\textless}li{\textgreater}6 units to farmers{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Total} demand for each variety therefore = 10{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Agri:} immobile  - 4 units in N, 2 units in S.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Location} of workers in manuf is not exogenous{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"The} role of the immobile workers is important, as they ensure that there is always positive demand in {\textless}em{\textgreater}both{\textless}/em{\textgreater} regions." [83]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Transport} costs between North and South are \$1 - firms make location decisions to minimise cost. See their little table on p.84{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}Used} to illustrate these 'distinctive characteristics' -{\textless}/p{\textgreater}
{{\textless}ol{\textgreater}{\textless}li{\textgreater}Cumulative} causation - i.e. agglomeration / feedback{\textless}/li{\textgreater}
{\textless}li{\textgreater}multiple equilibria (some stable, some not - i.e. can be tipped by one firm){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Stable} equilibria can be non-optimal (all firms can agglomerate somewhere with expensive transport costs){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Interaction} of agglomeration and trade flows - depending on regional mix of agglomeration, trade can be inter- or intra-industry. The former showing the home market effect{\textless}/li{\textgreater}
{{\textless}/ol{\textgreater}{\textless}p{\textgreater}What's} missing from the simple example?{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Interaction} of transport costs, price-setting behaviour and location choice [85] Assume demand is given and independent of price-setting behaviour and transport costs. {"In} reality, prices, wages and transport costs will determine the purchasing power of consumers" - which drives the location decisions of consumers and producers.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Firms} don't worry about what labour they need - "it will turn out that assumptions with regard to the functioning of the labour market are important." [86]{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}h2{\textgreater}Structure} of the model{\textless}/h2{\textgreater}
{{\textless}p{\textgreater}Nuts} and bolts of core model: Dixit Stiglitz 77 and Krugman 79/80{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Some} of this I know, so I'll try to pick up on what's new / useful. The diagram on p.87 is absolutely invaluable.{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Agri} production: constant {RtS,} perfect competition, {\textless}strong{\textgreater}no transport costs{\textless}/strong{\textgreater}{\textless}/li{\textgreater}
{\textless}li{\textgreater}n1 firms in region 1, n2 firms in region 2 - {\textless}br /{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}each producing a differentiated product{\textless}/li{\textgreater}
{\textless}li{\textgreater}using only labour, with internal economies of scale; "this implies firms have monopolistic power, which they use in determining the price of their product." [87]{\textless}/li{\textgreater}
{\textless}li{\textgreater}{\textless}strong{\textgreater}transport costs {\textless}/strong{\textgreater}incurred selling to another region; not so for own region; "as a result of the transport costs, exporting firms will {\textless}strong{\textgreater}charge a higher price {\textless}/strong{\textgreater}in the foreign region than in the home region." [87]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Consumers:}           
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Food} - homogenous good so they don't care where it's produced. No transport costs in getting to market, see? {(Implying} that farmers earn the same wage in both regions.){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Manuf} spending - "has to be allocated over the many varieties produced in regions 1 and 2." [88]          
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Transport} costs mean consuming domestic is (ceteris paribus) cheaper; but - {\textless}/li{\textgreater}
{{\textless}li{\textgreater}Variety-loving} means consumers will always have at least a little of everything [note: consumers are dealt with in aggregate, so the love of variety effect is also aggregate...]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}We're} going to deal with four model aspects:{\textless}/p{\textgreater}
{{\textless}ol{\textgreater}{\textless}li{\textgreater}Demand} structure{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Supply} structure{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Role} of transport costs{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Model} dynamics{\textless}/li{\textgreater}
{{\textless}/ol{\textgreater}{\textless}p{\textgreater}Q:} why would one assume manuf workers were mobile, agri not? Isn't the opposite true? The land is an immobile factor, but... oh: {"The} relocation of manufacturing firms from one region to another is the other side of the same coin, as an expansion of the manufacturing workforce in a region implies an expansion of production in the manufacturing sector." [88]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Though} still: "the farmers need the land for cultivation and are thus not mobile." [88] Well, I guess it's illustrating a point - but here's one of those enormously unrealistic assumptions. In some places, agri labour is enormously mobile.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} two are presumably bundled in one equation somehow... we shall see.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}So:} shaded boxes in model outline - can disappear if e.g. workers/firms all end up in one region. Unshaded boxes = immobile.{\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}}
},

@article{lucas_mechanics_1988,
	title = {On the mechanics of economic development},
	volume = {22},
	issn = {0304-3932},
	url = {http://www.sciencedirect.com/science/article/B6VBW-47N61RY-3/2/d5af17f237229feefc2278ac76c2bc56},
	doi = {10.1016/0304-3932(88)90168-7},
	abstract = {This paper considers the prospects for constructing a neoclassical theory of growth and international trade that is consistent with some of the main features of economic development. Three models are considered and compared to evidence: a model emphasizing physical capital accumulation and technological change, a model emphasizing human capital accumulation through schooling, and a model emphasizing specialized human capital accumulation through learning-by-doing.},
	number = {1},
	journal = {Journal of Monetary Economics},
	author = {Robert E. Lucas},
	month = jul,
	year = {1988},
	keywords = {economics},
	pages = {3--42}
},

@book{glaeser_cities_2008,
	title = {Cities, Agglomeration, and Spatial Equilibrium},
	isbn = {{019929044X}},
	publisher = {{OUP} Oxford},
	author = {Edward L. Glaeser},
	month = jul,
	year = {2008},
	keywords = {economics, geography, localisation},
	annote = {{{\textless}h2{\textgreater}Agglomeration} economies{\textless}/h2{\textgreater}
{{\textless}p{\textgreater}From} intro:{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}"Agglomeration} economies exist whenever people become more productive through proximity to others." [5]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Agglomeration} economies are the catchall explanation for why cities can be so productive and why so many people flock to urban areas." [5]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"If} the spatial equilibrium concept comes from the individual's location choice, agglomeration economies are inferred from the labour demand decisions of firms. High wages are a pervasive feature of cities [glaeser \&amp; mare, 2001]. The spatial equilibrium concept maintains that these high wages are offset by something else and indeed they are offset by high urban housing prices."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Q:} why are firms willing to locate in places where workers are so expensive? Must be offset by something else. Hmm - from all the reasons he gives, he doesn't yet mention "being near to workers"; some equlibiriating force: easier access to capital / "something pushing up the marginal product of labour." [6]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}But} space! "the absence of physical space between people and firms. Cities are density, proximity, closeness. The advantage of all that closeness is the absence of transport costs." [absence??] He notes this has led urban economists to focus on transport cost advantages. 
{{\textless}ul{\textgreater}{\textless}li{\textgreater}"Cities} eliminate transport costs for goods, people and ideas." [eliminate???]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}NEG,} he says {[Krugman,} Fujita, Venables 2001] "emphasise the cost savings associated with low shipping costs for goods."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}He} goes on to say this was appropriate for C19th, but less so now...{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Two} ways low transport costs from clustering help firms: 
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Home} market effect: being close to customers ['mechanism that lies at the heart of Krugman 1991']{\textless}/li{\textgreater}
{{\textless}li{\textgreater}That} talked about closeness to customers "but it is only a slight variant to assume that the core urban edge comes from firms that have to pay less for intermediate goods."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}I} always thought the main point of the home market effect was these cost savings' impact on exports? Central point: you tend to export what you're good at. [which looks a bit like {CA,} but can arise without {CA's} natural advantages.]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}From} C19th to 20th: story of transport costs becoming less important. Would like to see some numbers for that! {\textless}br {/{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}Major} transport hubs. Ports and railyards were key advantages for places; natural advantage for e.g. New York: large transatlantic shipping dropped stuff off that was ferried up the coast by smaller boats. {NY} also become an intermediary processing point for e.g. sugar that wouldn't make the voyage if already refined. Also {NY:} "river-based access to the hinterland."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"In} the nineteenth century, when moving goods overland was expensive, access to the transport advantages in Chicago and New York made firms much more productive." [7] So seen from a firm's point of view - place to be to reduce costs.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Cities} emerged around transport hubs. Question: does it even make sense to try and separate 'pure' agglomeration from natural advantage? Well cf Krugman: small differences can feed back into complete advantage; worth knowing that.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Note:} that's what Glaeser seems to think should be done - control for natural advantage to get at the underlying agglomeration, and don't mistake one for the other e.g. high population and wages around C19th ports != agglom.[7]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Glaeser:} transport costs now much less of an issue for agglom; C20th - rail freight costs dropped by 90\% {[Glaeser} \&amp; Kohlhase 2004] Other modes of transport "made it easy to ship goods over space. As a result, cities that once had an advantage based on moving goods over space lost that advantage and often lost their economic raison d'etre." Cf. Great Lakes region: Iron, Coal - he doesn't mention water, but presumably that too. Now: carmaking in Tennessee or Korea is possible. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}Glaeser} contrasts transport costs for goods w/ for people and ideas - which now dominate agglomeration, he believes. {\textless}br {/{\textgreater}{\textless}ul{\textgreater}{\textless}li{\textgreater}People's} time is now the largest element of transport cost, and that has become more and more valuable. [8]{\textless}/li{\textgreater}
{\textless}li{\textgreater}services more important; interaction between people dominates; {"The} dense urban markets for these services then create gains from specialisation and the division of labour." [8]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Idea-producing"} industries now dominating in agglom.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Though} cf. Marshall's "in the air" quote, and Jacobs: not new. {(Glaeser} sez Jacobs 1969, which is the economy of cities; Glaeser: "new ideas are formed by combining old ideas and in dense agglomerations, old ideas abound." [8]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}He} then goes on to other elements of 'modern urban economics' that don't directly come under agglom, but it's worth noting them: the 'bricks and mortar' of the physical infrastructure, and their transportation technology. Might be worth following up on John Meyer... 
{\textless}ul{\textgreater}{\textless}li{\textgreater}e.g. monocentric cities a hangover from C19th transport tech - water and rail lnk, when roads were very expensive.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Interesting} point: tech ability to build higher changes value of land... skyscapers etc.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Government:} he doesn't mention it as a 'natural advantage' which I would have thought it was like - being near to power makes you better connected, helps your business. Cf. lobbying groups. Instead, mentions political capitals growing wealthy off the backs of great leaders' plans. {(Which} often involved taxing hinterlands to fund urban growth.) [9]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Then} there's government regulation and zoning policy... {\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}/li{\textgreater}
{{\textless}li{\textgreater}William} Alonso: location and land use - need to read that at some point! Appears to be "seminal" re spatial equilibrium.{\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}p{\textgreater}From} later chapter:{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}"Agglomeration} economies are said to exist whenever an individual's productivity rise when he or she is near to other individuals." [116]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"Agglomeration} economies can explain urban density in a closed model that doesn't need to appeal to external factors, like ports or mines." [116]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}"The} key advantage from proximity and therefore the key agglomeration economy is the reduction of transport costs for goods, for people and for ideas." [117]{\textless}/li{\textgreater}
{\textless}li{\textgreater}(or as he says afterwards: 'proximity reduces transport costs for goods, for people and for ideas." A bit neater, though the same thing.){\textless}/li{\textgreater}
{\textless}li{\textgreater}cf. Krugman: lower transport costs themselves {\textless}strong{\textgreater}cause {\textless}/strong{\textgreater}agglomeration, rather than agglomeration being driven by a desire to lower transport costs. {(Outweighed} by proximity of markets... so different forces at play.){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Real} wages in cities appear to remain constant across cities: costs adjust. 177 {(Effect} of this spatial variation in inflation is what...?){\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}p{\textgreater} {\textless}/p{\textgreater}}
},

