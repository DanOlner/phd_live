@article{wheeler_localization_2007,
	title = {Do localization economies derive from human capital externalities?},
	volume = {41},
	issn = {0570-1864},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&search_mode=GeneralSearch&qid=15&SID=X2IOJGhGJaoneICFl6h&page=1&doc=1},
	abstract = {One of the most robust findings emerging from studies of industrial agglomeration is the rise in productivity that tends to accompany it. What most studies have not addressed, however, is the potential role played by human capital externalities in driving this relationship. This paper seeks to do so using data from the 1980, 1990, and 2000 {US} Census covering a collection of 77 (primarily) three-digit manufacturing industries across a sample of more than 200 metropolitan areas. The analysis generates two primary results. First, a variety of education- and experience-based measures of average human capital rise significantly as an industry's employment in a metropolitan area increases. Hence, clusters of industry do tend to be characterized by larger stocks of human capital. However, second, even after accounting for the level of human capital in a worker's own industry, the overall size of the industry remains strongly associated with wages. Such results cast some doubt on the notion that localization economies emanate from education- or experience-based knowledge spillovers.},
	number = {1},
	journal = {{ANNALS} {OF} {REGIONAL} {SCIENCE}},
	author = {{CH} Wheeler},
	month = mar,
	year = {2007},
	keywords = {economics, geography, localisation},
	pages = {31--50}
},

@book{wilson_complex_2000,
	title = {Complex Spatial Systems: The Modelling Foundations of Urban and Regional Analysis},
	isbn = {0582418968},
	shorttitle = {Complex Spatial Systems},
	publisher = {Prentice Hall},
	author = {Alan Wilson},
	month = jan,
	year = {2000},
	keywords = {economics, geography, localisation},
	annote = {{{\textless}h2{\textgreater}Agglomeration} economies{\textless}/h2{\textgreater}
{{\textless}p{\textgreater}Just} referring to pages in the index for 'agglomeration' and 'agglomeration economies' So -{\textless}/p{\textgreater}
{\textless}h3{\textgreater}p.34:{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}Interesting} list of principles based on Paelink and Nijkamp 1975 [operational theory and method in regional economics], but here's the one I'm interested in right now:{\textless}/p{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Indivisibilities} - lead to economies of scale, and spatial concentration / agglomeration economies{\textless}/li{\textgreater}
{{\textless}li{\textgreater}External} economies - e.g. cheaper transport costs for many firms producing in the same sector / related sectors etc. (and perhaps negative external economies too.) cf. Jacobs [external economies - just externalities?]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Compares} to Leontif {IO} analysis - hmm. They do cover this, wonder if/how they make it spatial?{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}h3{\textgreater}p.52-3{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}The} classic Weber's triangle problem - which even with one firm is not, apparently, analytically solveable. {(Trying} to find a minimum for Z=w1d1+w2d2+w3d3.) Surely that's solveable for particular values...? Aaanyhoo.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}When} more firms are introduced, even more of a problem. It's a nice little example - more alike to my stuff than von Thunen's. I should read his Theory of the Location of Industries. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}Hotelling} (1929), Palander (1935, Hoover (1937) considered. Hotelling, they say, most long-lasting significance.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Palander:} optimal outcome for 2 firms, making goods for same market{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Hoover:} many firms; later, dynamic methods, whatever they are{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Hotelling:} ice-cream vans on a beach - so a {1D} model, then. {(See} Alonso 1960, 1964){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Stable} equilibrium outcome is only where both are at the centre...cf. 'welfare optimum' of having one at each quartile so as to minimise consumer cost (in distance){\textless}/li{\textgreater}
{\textless}li{\textgreater}"an active treatment of the interactions of two 'firms' focusing on the process which generates the final pattern - in contrast to Weber, Palander and Hoover." [53]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}h3{\textgreater}p.110{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Note:} Arthur appears here, making a Markov-based location model. Agglomeration economies appear just as a multiplier though. {\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}h3{\textgreater}p.129{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Weber:} considers tendencies to agglomeration. {"Identifies} a number of factors which may make it attractive for plants to group together - either plants within a particular industry, or plants within different industries." [129]{\textless}/li{\textgreater}
{\textless}li{\textgreater}- {[Internal]} Scale economies and "more effectively shared overheads" which I think means external economies{\textless}/li{\textgreater}
{\textless}li{\textgreater}- other external economies: [forward linkages?] access to equipment manufd by other firms in the locality; "division of labour for all the firms in the locality." So labour market pooling - which does need breaking down a bit. Last: "improved marketing possibilities." Local market demand.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Land-rent:} deglomeration force{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Lots} more here to go back to! See labour particularly.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}h3{\textgreater}p.134{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Hotelling's} ice-cream vans: "not so much agglomeration economies that brings it about in such cases, but the outcome of the competitive process." [134]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}h3{\textgreater}p.146{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}On} Burgess, Hoyt, Harris, Ullman: {"In} logic, one might have expected a concentric ring theory, based on rent, to follow the work of von Thunen and an agglomeration theory in relation to centres to be based on the work of Weber, but these did not materialise. The Chicago sociologists looked towards plant ecology for their models; Hoyt and Harris and Ullman based their models on detailed empirical observation." [146] All very curious!{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}h3{\textgreater}p.149{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Re} Gravity models: note this quote from 1858 by Carey: "the greater the number collected in a given space, the greater the attractive force which is there exerted... Gravitation is here, as everywhere, in the direct ratio of the mass and the inverse one of distance."{\textless}/li{\textgreater}
{{\textless}li{\textgreater}This} is quoted by Carrothers 1956: what's interesting is on p.151 there's a quote from him - "the behaviour of molecules, individually, is not normally predictable, but in large numbers their behaviour is predictable on the basis of mathematical probability." He then compares to people, of course. So - {ABM:} just probability-generating machines? Cf. why go all {ABM} when we're tying to get *away* from disaggregation? Justify.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}},
	annote = {{{\textless}h3{\textgreater}STM:} System-theory-method{\textless}/h3{\textgreater}
{{\textless}ul{\textgreater}{\textless}li{\textgreater}Aim:} {STM} is used to analyse a number of different frameworks: how it defines the system it analyses; the theory that's used to understand that system, and the methods - the set of tools for operationalising that theory. {(Many} don't have this latter...){\textless}/li{\textgreater}
{{\textless}/ul{\textgreater}{\textless}h3{\textgreater}System} articulation{\textless}/h3{\textgreater}
{\textless}ul{\textgreater}{\textless}li{\textgreater}levels of resolution: raster, vector, zone etc... cf. Weber and {SI{\textless}/li{\textgreater}}
{\textless}/ul{\textgreater}}
},

@article{maier_spatial_2009,
	title = {Spatial prices, search behavior and location},
	volume = {43},
	url = {http://dx.doi.org/10.1007/s00168-007-0203-x},
	doi = {10.1007/s00168-007-0203-x},
	abstract = {Abstract  This paper presents a model that links spatial prices with search behavior and location. Consumers are assumed to search for
a product at the lowest overall costs where suppliers are spatially distributed. The expected result of this “shopping decision”
is linked with a longer term “quantity decision” relating the customer’s location via bid prices for land with the expected
costs of buying the product. We demonstrate various characteristics of this model via numerical simulations.},
	number = {1},
	journal = {The Annals of Regional Science},
	author = {Gunther Maier},
	month = mar,
	year = {2009},
	keywords = {agglomeration},
	pages = {27--48}
},

