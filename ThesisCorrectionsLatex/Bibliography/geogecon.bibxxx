@article{duranton_rising_2008,
	title = {Rising trade costs? Agglomeration and trade with endogenous transaction costs},
	volume = {41},
	issn = {0008-4085},
	shorttitle = {Rising trade costs?},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&colname=WOS&search_mode=CitingArticles&qid=4&SID=S2JalPmgknOkea34cgI&page=3&doc=28},
	abstract = {While transport costs have fallen, the empirical evidence also points at rising total trade costs. In a model of industry location with endogenous transaction costs that seeks to replicate features from the machinery industry, we show how and under which conditions a decline in transport costs can lead to an increase in the total cost of trade. The subtle relationship between (endogenous) transport costs and the sensitivity of trade to distance is also explored.},
	number = {1},
	journal = {{CANADIAN} {JOURNAL} {OF} {ECONOMICS-REVUE} {CANADIENNE} D {ECONOMIQUE}},
	author = {G Duranton and M Storper},
	month = feb,
	year = {2008},
	keywords = {agglomeration, geographical economics},
	pages = {292--319}
},

@article{glaeser_growth_1992,
	title = {Growth in Cities},
	volume = {100},
	issn = {0022-3808},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&search_mode=GeneralSearch&qid=19&SID=N216h7AKffeJjj7gc48&page=1&doc=3},
	abstract = {Recent theories of economic growth, including those of Romer, Porter, and Jacobs, have stressed the role of technological spillovers in generating growth. Because such knowledge spillovers are particularly effective in cities, where communication between people is more extensive, data on the growth of industries in different cities allow us to test some of these theories. Using a new data set on the growth of large industries in 170 {U.S.} cities between 1956 and 1987, we find that local competition and urban variety, but not regional specialization, encourage employment growth in industries. The evidence suggests that important knowledge spillovers might occur between rather than within industries, consistent with the theories of Jacobs.},
	number = {6},
	journal = {Journal of Political Economy},
	author = {{EL} Glaeser and {HD} Kallal and {JA} Scheinkman and A Shleifer},
	month = dec,
	year = {1992},
	keywords = {economics, geography, localisation},
	pages = {1126--1152}
},

@article{murata_engels_2008,
	title = {Engel's law, Petty's law, and agglomeration},
	volume = {87},
	issn = {0304-3878},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&colname=WOS&search_mode=CitingArticles&qid=4&SID=S2JalPmgknOkea34cgI&page=3&doc=22},
	doi = {10.1016/j.jdeveco.2007.06.001},
	abstract = {This paper presents a model of structural change and agglomeration. A decline in transportation costs, by enhancing consumers' purchasing power, leads to Engel's law of the demand shift from agricultural to non-agricultural goods. At the same time, the decline in transportation costs, by enlarging the extent of the market for non-agricultural goods, induces Petty's law of the labor reallocation from agriculture to non-agricultural activities. These structural transformations weaken dispersion forces given by farmers tied to the land, whereas they strengthen agglomeration forces generated by footloose non-agricultural workers. Thus, a substantial decline in transportation costs gives rise to agglomeration of non-agricultural activities. (c) 2007 Elsevier {B.V} All rights reserved.},
	number = {1},
	journal = {{JOURNAL} {OF} {DEVELOPMENT} {ECONOMICS}},
	author = {Y Murata},
	month = aug,
	year = {2008},
	keywords = {agglomeration, geographical economics},
	pages = {161--177}
},

@article{rodriguez-pose_how_2006,
	title = {How does trade affect regional disparities?},
	volume = {34},
	issn = {{0305-750X}},
	url = {http://www.sciencedirect.com/science/article/B6VC6-4K2SKF2-3/2/775a7008ad420116371a39c09589f298},
	doi = {10.1016/j.worlddev.2005.12.003},
	abstract = {Summary
Although the relationships between rising trade, economic growth, and international disparities have been well studied, those between trade and intranational disparities remain under-explored. In this paper, we present a theoretical formulation and empirical evaluation based on eight major world economies, finding that the link between trade and regional disparities is evidenced most strongly when sectoral shifts in trade composition are considered. As primary sector goods trade loses importance in the composition of total trade, regional disparities are likely to increase. This effect may have a greater negative impact on developing countries because the initial magnitude of intranational disparities tends to be greater in the developing world and its share of agricultural trade has historically been higher.},
	number = {7},
	journal = {World Development},
	author = {Andrés {Rodríguez-Pose} and Nicholas Gill},
	month = jul,
	year = {2006},
	keywords = {economics, geography},
	pages = {1201--1222}
},

