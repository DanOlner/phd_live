	volume = {1},
	url = {http://dx.doi.org/10.1023/A:1010074805303},
	doi = {10.1023/A:1010074805303},
	abstract = {Ecological approaches to agriculture can provide useful guidelines for addressing world food needs, while avoiding adverse environmental and social impacts. Experiments in both natural and agricultural ecosystems suggest that systems with high plant diversity may be more productive, more stable and more resilient than species-poor systems. In addition, systems with high plant diversity support higher levels of biodiversity in other functional groups, which may enhance the productivity of the plant component. Given these benefits of diverse systems, various approaches for converting conventional high input agricultural systems to more sustainable systems are addressed. Andow and Hidaka's (1989) concept of production syndromes is considered in the context of conversion to sustainable agriculture.},
	number = {3},
	journal = {Environment, Development and Sustainability},
	author = {Alison G. Power},
	year = {1999},
	keywords = {agroecology, complexity, food},
	pages = {185--196},
