@book{berkun_making_2008,
	edition = {illustrated edition},
	title = {Making Things Happen: Mastering Project Management {(Theory} in Practice},
	isbn = {0596517718},
	shorttitle = {Making Things Happen},
	publisher = {{O'Reilly} Media, Inc.},
	author = {Scott Berkun},
	month = mar,
	year = {2008},
	keywords = {behaviour},
	annote = {{\textless}p{\textgreater}{\textless}span {class="docEmphStrong"{\textgreater}"The} hardest single part of building a software system is deciding what to build. No other part of the conceptual work is as difficult in establishing the detailed technical requirements, including the interfaces to people, to machines, and to other software systems. No other part of the work so cripples the results if done wrong. No other part is more difficult to rectify later. Therefore, the most important function that the software builder performs for the client is the iterative extraction and refinement of the product requirements."{\textless}/span{\textgreater}{\textless}/p{\textgreater}
{\textless}p {class="docText"{\textgreater}—{\textless}span} {class="docEmphasis"{\textgreater}Fred} Brooks{\textless}/span{\textgreater}{\textless}/p{\textgreater}
{\textless}p {class="docText"{\textgreater}} {\textless}/p{\textgreater}},
	annote = {{{\textless}p{\textgreater}Two} reasons for reading: help with actually doing stuff + thinking about how people actually make decisions.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}So:} here's a start quote:{\textless}/p{\textgreater}
{\textless}p style="padding-left: {30px;"{\textgreater}It's} not surprising then that of the project managers I interviewed, few had formal training in decision making, and of those who did, few used it often. This anecdotal observation fits with what Gary Klein wrote in his book, {\textless}span {class="docEmphasis"{\textgreater}Sources} of Power: How People Make Decisions{\textless}/span{\textgreater} {(MIT} Press, 1999): "... be skeptical of courses in formal methods of decision making. They are teaching methods people seldom use." Klein goes on to explain the many different ways that skilled airline pilots, firefighters, and trauma nurses make decisions, and how rare it is that formalized methods found in textbooks are used to get things done. This doesn't mean these methods are bad, just that the textbooks rarely provide any evidence about who uses the methods or how successful they are, compared to other techniques.{\textless}/p{\textgreater}
{\textless}p {class="docText"} style="padding-left: {30px;"{\textgreater}Much} like project managers, Klein observed that these skilled professionals rarely have enough information or time to make those decision methods work. Instead, they have four things: experience, intuition, training, and each other. They make good decisions by maximizing those resources. In some cases, such as with fighter pilots or medical students, training is designed with this in mind. Instead of memorizing idealized procedures or theories during training, an emphasis is placed on developing experience through simulations of common problems and challenges.{\textless}/p{\textgreater}
{\textless}p {class="docText"{\textgreater}Some} points from that:{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{{\textless}li{\textgreater}Theories} of decision-making isn't "how people actually make decisions." That description - "experience, intuition, training, each other" - could mean adaptive, not procedural. Note: that ties to theories of cognition. {\textless}/li{\textgreater}
{{\textless}li{\textgreater}What} are we trying to achieve by investing software agents with any kind of decision-making ability? Two things to recognise: 
{\textless}ul{\textgreater}
{{\textless}li{\textgreater}There's} no point in trying to mimick decision-making processes precisely in the hope of getting predictive power. There's the flocking example I want to work up at some point. {(Though} it depends on what it is you're trying to predict exactly... cf. Earthquakes.){\textless}/li{\textgreater}
{{\textless}li{\textgreater}Any} decision-making theory may be a shortcut from reality to allow a model to be created. But how to justify any particular choice? E.g. rational utility maximising of shoppers can - perhaps - only be read back from aggregates to the individuals. In reality, the individuals don't work that way (perhaps they realise when a basket is too cheap or too expensive, but that's a fuzzy boundary, with variation amongst people) - but the result may look the same in the aggregate. {\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{\textless}/li{\textgreater}
{{\textless}li{\textgreater}So} - crop decisions: I shouldn't be expecting to get any realistic picture of exactly how an area might turn out. I can only hope to look for boundary conditions. And perhaps other sorts of system dynamics - compare again to decisions in a flock. {\textless}/li{\textgreater}
{\textless}/ul{\textgreater}}
},

@article{walker_iteration_1988,
	title = {Iteration in Walras's theory of tatonnement},
	volume = {136},
	url = {http://dx.doi.org/10.1007/BF01151806},
	doi = {10.1007/BF01151806},
	abstract = {Summary It has been argued that Léon Walras did not have a theory of economic tatonnement but was instead concerned with a technique of mathematical iteration for the purpose of finding the solutions to the equations of a model of general equilibrium, that his work lacks an account of a means whereby prices are changed, and that he was uninterested in real economic adjustment processes. It is concluded that those judgments are incorrect. It is shown that Walras wanted to develop a realistic theory of time-consuming economic tatonnement in a freely competitive economy, and that he based it on his theories of how prices are changed, of iterative pricing, of entrepreneurial iterative behavior, and of a presumed convergence of the variables to equilibrium.},
	number = {3},
	journal = {De Economist},
	author = {Donald A. Walker},
	year = {1988},
	keywords = {abm, ace, economics},
	pages = {299--316},
	annote = {{{\textless}p{\textgreater}Walras} - "gave many accounts of markets undergoing repeated price adjustments that bring them progressively closer to equilibrium."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Critique:} Walras was looking for math techniques to find equation solutions, not considering the real world.{\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}}
},

