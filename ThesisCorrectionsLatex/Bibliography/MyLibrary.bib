@article{ak&xe7;omak_social_????,
	title = {Social capital, innovation and growth: Evidence from Europe},
	shorttitle = {Social capital, innovation and growth},
	url = {http://www.sciencedirect.com/science?_ob=ArticleURL&_udi=B6V64-4TRK0SR-1&_user=10&_coverDate=10%2F22%2F2008&_rdoc=1&_fmt=&_orig=search&_sort=d&view=c&_acct=C000050221&_version=1&_urlVersion=0&_userid=10&md5=cef4e40449d605bf02cec27b83594a31},
