@article{blume_trading_????,
	title = {Trading networks with price-setting agents},
	volume = {In Press, Corrected Proof},
	issn = {0899-8256},
	url = {http://www.sciencedirect.com/science/article/B6WFW-4V74XP6-1/2/e3a99d151cefad795e2a1b1d9661201a},
	doi = {10.1016/j.geb.2008.12.002},
	abstract = {In a wide range of markets, individual buyers and sellers trade through intermediaries, who determine prices via strategic considerations. Typically, not all buyers and sellers have access to the same intermediaries, and they trade at correspondingly different prices that reflect their relative amounts of power in the market. We model this phenomenon using a game in which buyers, sellers, and traders engage in trade on a graph that represents the access each buyer and seller has to the traders. We show that the resulting game always has a subgame perfect Nash equilibrium, and that all equilibria lead to an efficient allocation of goods. Finally, we analyze trader profits in terms of the graph structure -- roughly, a trader can command a positive profit if and only if it has an "essential" connection in the network, thus providing a graph-theoretic basis for quantifying the amount of competition among traders.},
	journal = {Games and Economic Behavior},
	author = {Lawrence E. Blume and David Easley and Jon Kleinberg and Éva Tardos},
	keywords = {economics, networks}
},

