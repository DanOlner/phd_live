@article{sudhakara_reddy_great_2009,
	title = {The great climate debate},
	volume = {37},
	issn = {0301-4215},
	url = {http://www.sciencedirect.com/science/article/B6V2W-4W7HP3W-3/2/f64808c80cb806fc7cd5188f5400aa56},
	doi = {10.1016/j.enpol.2009.03.064},
	abstract = {For over two decades, scientific and political communities have debated whether and how to act on climate change. The present paper revisits these debates and synthesizes the longstanding arguments. Firstly, it provides an overview of the development of international climate policy and discusses clashing positions, represented by sceptics and supporters of action on climate change. Secondly, it discusses the market-based measures as a means to increase the win-win opportunities and to attract profit-minded investors to invest in climate change mitigation. Finally, the paper examines whether climate protection policies can yield benefits both for the environment and the economy. A new breed of analysts are identified who are convinced of the climate change problem, while remaining sceptical of the proposed solutions. The paper suggests the integration of climate policies with those of development priorities that are vitally important for developing countries and stresses the need for using sustainable development as a framework for climate change policies.},
	number = {8},
	journal = {Energy Policy},
	author = {B. Sudhakara Reddy and Gaudenz B. Assenza},
	month = aug,
	year = {2009},
	keywords = {climate change},
	pages = {2997--3008}
},

@book{ploeg_labour_1990,
	title = {Labour, Markets and Agricultural Production},
	isbn = {0813378273},
	publisher = {Westview Press Inc},
	author = {Jan Douwe van der Ploeg},
	month = dec,
	year = {1990},
	keywords = {agroecology},
	annote = {{{\textless}h3{\textgreater}Intro:} heterogeneity and styles of farming{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}Some} key phrases / points:{\textless}/p{\textgreater}
{\textless}p{\textgreater}"the strategic meaning of yields." [9]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Variety} (of yields, everything else) is the norm.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Tradition} since 1900: 'intensive farming' - {"Good} farming means farming so carried out as to produce the maximum economic output from the land." {[Graham} Brade Birks 1950 - {'Modern} Farming: A practical illustrated guide]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Extensive} - "the practice of using the minimum amounts of labour, cultivation and manure." [same]{\textless}/p{\textgreater}
{\textless}p{\textgreater}[3]{\textless}/p{\textgreater}
{\textless}p{\textgreater}1950s - shift to neoclassical agri econs. [4] Getting the optimum solution from current price relations. Involves "taking up of externally developed innovations." [extension]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"It} is striking that, with the emergence of this neoclassical model, concern for a dynamic that could be produced within the farm itself disappears from the literature." Intensive and extensive disappear - ventures can also be 'too intensive'. [not efficient...]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Possible} reasons for differences in yields:{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{\textless}li{\textgreater}micro-ecological conditions or differences in prices/ costs? {(He} doesn't seem to agree with either.){\textless}/li{\textgreater}
{\textless}li{\textgreater}"imperfections in the institutional environment"...? Transport, credit, etc... [hmm: Rodrik?]{\textless}/li{\textgreater}
{\textless}li{\textgreater}differing innovation diffusion rates."a problem localized primarily in the psyche of the individual farmer." {\textless}/li{\textgreater}
{{\textless}li{\textgreater}Or} the "randomly bestowed distribution of individual talents among farmers."  [5] {\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{{\textless}p{\textgreater}He} argues: these are all exogenous to the model - residual factors. Whereas we need to integrate diversity {\textless}strong{\textgreater}into {\textless}/strong{\textgreater}the models, rather than explain them away.{\textless}/p{\textgreater}
{\textless}p{\textgreater}[6] -{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{{\textless}li{\textgreater}Japanese} model: intensification, raising production per unit of land{\textless}/li{\textgreater}
{{\textless}li{\textgreater}American} model: opposite strategy - 'scale enlargement'; raising the land/man ratio or lowering the labour input per unit of land.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{{\textless}p{\textgreater}From} Hayami and Ruttan [1971] -{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Countries} go either japanese or american due to relative factor prices:{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{\textless}li{\textgreater}scale enlargement likely where land is cheap and labour relatively expensive "especially if labour saving technology is available"{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Land} scarce and labour over-abundant - intensification. Clearly.{\textless}/li{\textgreater}
{\textless}li{\textgreater} = a "repetition of the neoclassical model." [7]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{{\textless}p{\textgreater}Their} analysis done at country-level - "each country representing a specific constellation of relative factor prices. Beyond that, the model implicitly assumes that relative factor prices are 'always and everywhere' translated in the same unilinear way in terms of the direction and rhythm of agrarian development."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}His} case studies - a tantalising answer to why yields for certain units are higher: "the result of the way in which such cooperatives are linked into their economic environment and of the social struggle that some cooperatives pursue: a strugle for the right to work, which in present-day agriculture is becoming increasingly marginalised." [8]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"{\textless}strong{\textgreater}Styles} of farming{\textless}/strong{\textgreater} (or soil use) can be defined as a valid structure of relations between producers, objects of labour, and means. {'Valid'} means that at least those directly concerned consider the structure as an adequate means for making a living." [12]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"How} many styles of farming there are, the degree to which they explain variance, and the extent to which they are linked to structural differences in agricultural development patterns, are questions which a priori are not easily answered. They are themes for further research." [12]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"Farming} styles" are continuously reproduced / changed through {\textless}strong{\textgreater}farm labour{\textless}/strong{\textgreater}; "farm labour as a conscious activity assumes the {\textless}strong{\textgreater}formation and use of goals{\textless}/strong{\textgreater} towards which organisation and development of production will be oriented; it assumes also the development of the means or qualities to effectively pursue such goals. Ends and means will together form a rational pattern." [12]{\textless}/p{\textgreater}
{{\textless}h3{\textgreater}Historically} guaranteed relatively autonomous reproduction {[HGRAR]{\textless}br} /{\textgreater}{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}"Farm} labour cannot be reduced to the production of cetrain end products such as milk, meat, potatoes and grain, for it is also interwoven, in a variety of different ways, with reproduction." {(Ploeg} 1990, p.13) From material to social relations.{\textless}br /{\textgreater}{\textless}br {/{\textgreater}'Historically} guaranteed' reproduction - "each cycle assumers the availability of land, labour, capital and all kinds of inputs produced in the previous cycle."{\textless}br /{\textgreater}{\textless}br {/{\textgreater}Ratio} between marketed output and reproduced production factors. Short and long-term perspectives must be balanced.  [14] {[Aim:} maximise marketed output / minimise ratio?]{\textless}br /{\textgreater}{\textless}br {/{\textgreater}"Once} such a decision is made, it follows that each cycle will begin with a given amount of production factors and inputs. With this the farmermust work in such a way that a maximum output is reached, for in this way both short-term interests and long-term needs are optimized." [14]{\textless}br {/{\textgreater}Key} for achieving this - raise technical efficiency.{\textless}br /{\textgreater}{\textless}br {/{\textgreater}Note:} a very different picture to a constantly optimising production function - many of these reproducing patterns fade to the background unless disturbed. They are 'norms' that, under normal conditions, only slowly alter. Again - an algedonic picture of production. Also, optimisation has no history - if new opportunities appear, it takes them.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}{\textless}strong{\textgreater}Markets} always part of farming: {\textless}/strong{\textgreater}because of usefulness of iron, crops always cultivated to exchange for gold in order to get it. {[Marc} Bloch.] So commodity production never secondary. [15]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}{\textless}strong{\textgreater}Example} of reproduced factors being exported:{\textless}/strong{\textgreater} Friesland -{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{{\textless}li{\textgreater}A} period of 100s of ships exporting manure, hay and the best breeding cattle{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Only} later was there 'historically guaranteed' reproduced, non-commodified... 1860 - 70. {\textless}/li{\textgreater}
{\textless}li{\textgreater}"hay, manure and good cows were no longer sold but kept on the farm to produce more and better milk and butter."{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{{\textless}p{\textgreater}In} whose interests was it at each stage?{\textless}/p{\textgreater}
{\textless}p{\textgreater}1930s: power struggle in farming organisations. Hmm. Example of Groningen - "the idea that farmers could make progress over the longer term through their own means was essential for improving stock, for raising soil fertility, and for creating the infrastructure needed for irrigation and drainage." [16]{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Ex} of Netherlands 1850 - 1900: increase in production not exogenous, not through comparative advantage, nor externally extended tech - in fact the farms became more mixed. The underlying factor: an increase in labour, and a corresponding increase in the quality of the reproduced factors.{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{{\textless}li{\textgreater}Fat} years - save in them, invest in farm{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Thin} years - investment maybe boosted production, so prices dropped...{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{{\textless}h3{\textgreater}Market} dependent reproduction{\textless}/h3{\textgreater}
{{\textless}p{\textgreater}Factors} - mobilising wholly or largely through the relevant markets. {[Note} to me: misses point about other social technologies? And, how does it fit into non-tradeable inputs?]{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{\textless}/ul{\textgreater}
{{\textless}p{\textgreater}Total} output considered marketable - hmm, that's true. Waste is inefficient, but waste is what can't be sold.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"Harvest} prices at the end of the cycle will determine the extent to which the production process can be reproduced. Only if the costs can be valorised can a following cycle be organised. Reproduction  thus indeed becomes in essence, market-dependent. The latter implies that in the actual process of production, economic efficiency must be optimised: the production process must be organised to comply with prevailing market relations and in such a way that the difference between costs and benefits is optimal." [17]{\textless}/p{\textgreater}
{\textless}p{\textgreater}cf. the requirement for inputs and energy - non-market solutions...?{\textless}/p{\textgreater}
{{\textless}p{\textgreater}HGRAR:} market = outlet; not a "structuring principle" that determines farming in the same way as market-dependent reproduction "where commodity relations penetrate to the heart of the production process and exercise a strongly directive effect."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Hmm:} process of getting market-dependent sounds drunk walky.{\textless}/p{\textgreater}
{\textless}p{\textgreater}18: Ploeg points out there are very, very many farming tasks - and they can always be broken down into smaller ones. E.g. "in grain cultivation alone, 400 decisions are identifiable." Eek.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Oh} my God I can't stop quoting him in full:{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"The} first point to be made here is that{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{\textless}li{\textgreater}all these tasks must be closely coordinated in farm labour{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Choice} of seed, of the way to work the land (including plouging), the timing of fertilising, and the composition of manure must all be carefully interrelated.  
{\textless}ul{\textgreater}
{{\textless}li{\textgreater}If} they are not, excessively high costs or wastage can result, as well as disappointing harvests. One can go a step further: to an important degree...{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{\textless}/li{\textgreater}
{\textless}li{\textgreater}the basis for endogenous progress lies in this continuous interrelating and coordinating of tasks. The farmer can, through his own labour process, and through continual observation, interpretation, evaluation and manipulation, identify positive and negative consequences and{\textless}/li{\textgreater}
{\textless}li{\textgreater}translate the insights gained from this process into possible improvements in the coordination of tasks.[18]{\textless}/li{\textgreater}
{{\textless}li{\textgreater}The} need for a close coordination of tasks holds a fortiori {\textless}strong{\textgreater}if production and reproduction are systematically combined{\textless}/strong{\textgreater} in the labour process. [19] The farmer can then, through a gradual improvement of his objects of labour (land, cattle, plant material, etc) lay the groundwork for higher production levels in cycles to come.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}The} same holds for the reproduction of labour and the means of production. The quantity and, above all, the quality of labour can be raised in the reproduction process just as the means can be improved.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{{\textless}p{\textgreater}Me:} again - looks like a question of allowing reflexive adaptation and learning to take place.{\textless}/p{\textgreater}
