@article{duranton_journal_2010,
	title = {The Journal of Regional Science at 50: Looking Forward to the Next 50 Years},
	volume = {50},
	issn = {00224146},
	shorttitle = {{\textless}title xmlns="http},
	url = {http://0-www3.interscience.wiley.com.wam.leeds.ac.uk/cgi-bin/fulltext/123239052/main.html,ftx_abs},
	doi = {10.1111/j.1467-9787.2009.00654.x},
	number = {1},
	journal = {Journal of Regional Science},
	author = {Gilles Duranton},
	year = {2010},
	pages = {1--3},
	annote = {{{\textless}p{\textgreater}Celebrating} 50 years of the {{\textless}span{\textgreater}Journal} of  Regional Science{\textless}/span{\textgreater} is a landmark for both the {{\textless}span{\textgreater}Journal{\textless}/span{\textgreater}} and  its field. I am greatly honored that the editors asked me to be the  guest editor for this Golden issue. To the extent that they can be  considered separately, both the {{\textless}span{\textgreater}Journal{\textless}/span{\textgreater}} and  Regional Science as a field have much to be proud about regarding their  first 50 years. Although we still fall short of Walter Isard's initial  objective, a lot has been done since this pioneering era. Regional  Science has steadily built up and spatial methods are now well  established. During the 1960s, urban economics took off, mostly after  the impetus of William Alonso, one of Isard's students. During the early  1990s, Paul Krugman and a number of associates have launched a new  brand of regional economics, the so-called New Economic Geography {(NEG).}  The Nobel Committee for Economics recognized this as a major  achievement when awarding the Economics Nobel Prize to Paul Krugman last  year. During the last 20 years, Ed Glaeser, Vernon Henderson, and  others have also contributed to revitalize empirical work in the field  and brought it to the modern age.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} objective of this Golden issue, however, is not to  look back but, instead, to look forward. Two recent anniversary issues  of {{\textless}span{\textgreater}Papers} in Regional Science{\textless}/span{\textgreater} and {{\textless}span{\textgreater}Regional}  Science and Urban Economics{\textless}/span{\textgreater} did a fine job of looking at the  past. They managed to avoid complacency and bitterness, the two evils of  that often come with retrospective looks. There is not much to add to  these two special issues. Instead, this Golden issue of the {{\textless}span{\textgreater}Journal} of Regional Science{\textless}/span{\textgreater} is forward looking. The  danger here is that there is often much frivolity when indulging in  futurology. To avoid this pitfall, this Golden issue aimed at getting  some of the best brains in the field to give us their vision for the  next few years. Hopefully, this will shape the long-run evolution of the  field without having to speculate about the far future.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}In} my initial letter to the authors, I asked them to  choose what they thought was a fundamental issue, deliver a quick primer  on where we currently stand, and make a number of suggestions for  future research. My explicit aim was that each paper should contain the  seeds of a number of {PhD} dissertations. The papers in this special issue  differ in what they do and how they do it. Nonetheless, they are all  great sources of inspiration. Hopefully, many bright young minds will  rise to the challenges underscored in the papers that follow. As a  personal comment, let me add that editing this issue has been very  rewarding. Nearly everyone I contacted agreed to participate in this  venture. In most cases, the authors ended up delivering more than I  expected both in terms of quality and quantity. Amazingly enough,  sometimes they even did this before the deadline. None of the authors  got paid and no-one was looking to add another line to their {CV.} This is  academia at its best.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Putting} together this special issue was not solely the  job of the guest editor. The "regular" editors and the editorial  assistant, Casey Wagner, have been extremely helpful at all stages of  the process. We were also greatly helped by financial support from the  National Science Foundation and the Federal Reserve Bank of New York.  The latter kindly hosted a conference in April 2009 where all the papers  in this issue were first presented. The published versions have greatly  benefitted from the intense exchanges that took place during these two  spring days in New York.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}This} Golden issue is forward looking but would never  claim to offer a complete or a fully consistent vision for the future.  First, practical constraints led to a dominance of North American  contributors. Second, the choice of contributors also obviously reflects  the biases of the guest editor. Third, the discretion of the authors  implied that some topics have been covered less than might have been  desirable. But the aim for this issue is to inspire, not to be a  dictionary and inspiration could only come from complete academic  freedom. Finally, as shall be clear to the readers, the authors are not  always in full agreement with each other in which direction to take. I  hope that these tensions make this issue worth more than the sum of its  parts.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}This} special issue is divided into six parts knowing  that many papers may not fit nearly into these categories. The first  group of papers is mostly concerned with methods. Tom Holmes discusses  the pros and the cons of various ways of doing empirical work in  Regional Science. Dan Rickman assesses how far modern macroeconomics may  rejuvenate traditional regional analysis. Esteban {Rossi-Hansberg} and  Klaus Desmet lay down an ambitious agenda to introduce dynamics into  spatial modeling. While their approach is very much bottom-up, Elena  Irwin argues that, on land use issues, much might be gained by taking  existing approaches that contain little economics and enrich them. It is  more of a top-down strategy for moving forward. Finally, Marcus  Berliant opines on whether behavioral economics might represent the way  forward for theorizing in regional and urban economics.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} second group of papers is more focused on particular  tools. Joris Pinkse and Margaret Slade in one paper and Dan {McMillen} in  another address different aspects of spatial econometrics and, more  generally, spatial modeling. Alan Murray provides a summary of recent  work in quantitative geography. Henry Overman discusses how new tools  from geographical information science might be useful for Regional  Science research. Finally, Harvey Miller shows how the greater  availability of data could affect how we do research.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} third group of papers looks at various aspects of  agglomeration. Diego Puga reviews the recent literature estimating the  magnitude and sources of agglomeration economies. Ed Glaeser and Matthew  Resseger provide a crisp summary of a fundamental but still poorly  understood issue: the complementarity between skills and cities. Related  to this, Marigee Bacolod, Bernardo Blum, and Will Strange develop an  agenda to explore how cities affect and reward skills at a very detailed  level.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} {NEG,} a major evolution in Regional Science in the  last 15–20 years, is concerned with large spatial scales. Jacques Thisse  provides the simplest model that can generate all the key results of  the {NEG} and challenges future research to connect it more to standard  urban research. Steve Redding reviews recent empirical development of  the {NEG} and explores promising future directions. Michael Storper  underscores what is missing from contemporary {NEG} research but would be  needed for a satisfactory understanding of a number of "big picture"  developments.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} fifth group of papers is concerned with local  interactions. Yannis Ioannides and Giorgio Topa examine recent research  attempting to identify neighborhood effects. In a complementary paper,  Ingrid Gould Ellen and Kathy {O'Regan} argue that there is a broad range  of issues associated small spatial scales that remain underexplored.  Holger Sieg, Dennis Epple, and Brett Gordon show how structural analysis  can be used to make progress on a number of local questions. Finally,  Andy Haughwout examine how traditional local public analysis can be  operationalized and applied to understand the functioning of large city  regions.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Regional} Science should not be isolated and much of what  it does overlaps partly with other fields. In the last series of  papers, the interactions between Regional Science and neighboring fields  are discussed. Tood Sinai does it for real estate, Maureen Kilkenny for  agricultural economics, Robin Lindsey for transportation, and, finally,  Vernon Henderson for development.{\textless}/p{\textgreater}}
},

@article{power_linking_1999,
	title = {Linking Ecological Sustainability and World Food Needs},
	volume = {1},
	url = {http://dx.doi.org/10.1023/A:1010074805303},
	doi = {10.1023/A:1010074805303},
	abstract = {Ecological approaches to agriculture can provide useful guidelines for addressing world food needs, while avoiding adverse environmental and social impacts. Experiments in both natural and agricultural ecosystems suggest that systems with high plant diversity may be more productive, more stable and more resilient than species-poor systems. In addition, systems with high plant diversity support higher levels of biodiversity in other functional groups, which may enhance the productivity of the plant component. Given these benefits of diverse systems, various approaches for converting conventional high input agricultural systems to more sustainable systems are addressed. Andow and Hidaka's (1989) concept of production syndromes is considered in the context of conversion to sustainable agriculture.},
	number = {3},
	journal = {Environment, Development and Sustainability},
