@article{jones_oil_2004,
	title = {Oil price shocks and the macroeconomy: What has been learned since 1996},
	volume = {25},
	issn = {0195-6574},
	shorttitle = {Oil price shocks and the macroeconomy},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&colname=WOS&search_mode=CitingArticles&qid=39&SID=R16M@ngDHFkHIPk4312&page=1&doc=3},
	abstract = {This paper reports on developments in theoretical and empirical understanding of the macroeconomic consequences of oil price shocks since 1996, when the {U.S.} Department of Energy sponsored a workshop summarizing the state of understanding of the subject. Four major insights stand out. First, theoretical and empirical analyses point to intra- and intersectoral reallocations in response to shocks, generating asymmetric impacts for oil price increases and decreases. Second, the division of responsibility for post-oil-price shock recessions between monetary policy and oil price shocks, has leaned heavily toward oil price shocks. Third, parametric statistical techniques have identified a stable, nonlinear, relationship between of L price shocks and {GDP} from the late 1940s through the third quarter of 2001. Fourth, the magnitude of effect of an oil price shock on {GDP,} derived from impulse response functions of oil price shocks in the {GDP} equation of a {VAR,} is around -0.05 and -0.06 as an elasticity, spread over two years, where the shock threshold is a price change exceeding a three-year high.},
	number = {2},
	journal = {{ENERGY} {JOURNAL}},
	author = {{DW} Jones and {PN} Leiby and {IK} Paik},
	year = {2004},
	keywords = {economics, energy, transition},
	pages = {1--32}
},

@article{earl_alternative_2010,
	title = {Alternative perspectives on connections in economic systems},
	volume = {20},
	url = {http://dx.doi.org/10.1007/s00191-009-0147-7},
	doi = {10.1007/s00191-009-0147-7},
	abstract = {Abstract  This paper explores the significance of Potts’s (2000) claim that the key difference between orthodox and heterodox economics lies in the former viewing the economy as a mathematical
field in which everything is connected to everything else, and the latter viewing it as a complex system in which only some
elements are connected. It focuses on the types of connections in economic systems that different economists have identified
and the significance of the degree of connectivity for how economic systems function. Topics explored include separable consumer
networks, separable utility functions, checklist-based decision rules, lifestyles, goodwill, the nature of business strategies
and evolution.},
	number = {2},
	journal = {Journal of Evolutionary Economics},
	author = {Peter Earl and Tim Wakeley},
	month = apr,
	year = {2010},
	keywords = {evolution},
	pages = {163--183}
},

@article{anderson_development_2007,
	title = {The development of a healthy eating indicator shopping basket tool {(HEISB)} for use in food access studies - identification of key food items},
	volume = {10},
	issn = {1368-9800},
	url = {http://apps.isiknowledge.com/full_record.do?product=UA&colname=WOS&search_mode=CitingArticles&qid=47&SID=Z2eD8mjkOChkOgK71Hc&page=1&doc=3},
	abstract = {Objectives: To develop an objective, nutrient-based, healthy eating indicator shopping basket {(HEISB)} tool for use in studies of access to healthy food. Design: Tool development used a literature search to identify previous practice, web information on current definition of healthy foods by the {UK} Food Standards Agency, and population-based dietary surveys to identify culturally acceptable foods. These findings were then appraised with respect to practical fieldwork considerations. Setting: The review took account of surveys undertaken in a range of geographical areas. Results: Previous tools have varied in the foods selected and the rationale for inclusion. Most have considered nutritional composition but no systematic definition has been used and foods have been subjectively classified as 'less healthy' or 'more healthy'. Recent {UK} work on nutrient profiling enabled individual food items to be objectively assessed for inclusion. Data from national food surveys enabled commonly consumed and culturally acceptable foods to be identified. Practical considerations included item use in meals, convenience, price, and fieldwork constraints. Other issues including health and price discriminators as well as regional preferences were considered. The final {HEISB} tool comprised 35 items within the following categories - 17 from fruit and vegetables, nine from potatoes, bread and cereal, five from fish/meats, three from dairy, and one from fatty and sugary foods. Conclusions: The tool provides a rational basis for examining access and availability of healthy foods in cross-sectional and longitudinal retail and consumer studies.},
	number = {12},
	journal = {{PUBLIC} {HEALTH} {NUTRITION}},
	author = {{AS} Anderson and J Dewar and D Marshall and S Cummins and M Taylor and J Dawson and L Sparks},
	month = dec,
	year = {2007},
	keywords = {food, methodology, nutrition},
	pages = {1440--1447},
	annote = {{{\textless}p{\textgreater}Can\&apos;t} get hold of a copy of this, but see related...{\textless}/p{\textgreater}}
},

@article{graham_identifying_2009,
	title = {Identifying urbanisation and localisation externalities in manufacturing and service industries},
	volume = {88},
	url = {http://www.ingentaconnect.com/content/bsc/pirs/2009/00000088/00000001/art00005},
	doi = {10.1111/j.1435-5957.2008.00166.x},
	abstract = {This article estimates urbanisation and localisation economies for two digit manufacturing and service industries. The analysis is based on estimation of a translog production-inverse input demand system using data on British firms. We use distance-based measures of localisation to test for the spatial transmission of externalities. We identify positive localisation economies for 13 of the 27 sectors examined. The results indicate that where localisation economies exist, they tend to attenuate fairly rapidly with distance. All localisation externalities are identified within a 10 kilometre radius of the firm. Positive elasticities of productivity with respect to urbanisation are identified for 14 sectors. The weighted average localisation elasticity for manufacturing industries is 0.03 and for services 0.01. The mean urbanisation elasticities are 0.07 and 0.19 respectively. Resumen Este artículo estima economías de urbanización y localización para industrias manufactureras y de servicios de dos dígitos. El análisis está basado en la estimación de un sistema translog de producción inversa de demanda de insumos utilizando datos de empresas británicas. Utilizamos medidas de localización basadas en la distancia para comprobar la transmisión espacial de externalidades. Identificamos economías de localización positivas para 13 de los 27 sectores examinados. Los resultados indican que allí donde existen economías de localización, éstas tienden a atenuarse bastante rápidamente en función de la distancia. Todas las externalidades de localización están identificadas dentro de un radio de 10 km de la empresa. Se identifican para 14 sectores elasticidades de producción positivas con respecto a la urbanización. El promedio ponderado de elasticidad de la localización para industrias manufactureras es de 0.03 y para servicios de 0.01. Las medias de elasticidades de la urbanización son 0.07 y 0.19 respectivamente.},
	journal = {Papers in Regional Science},
	author = {Daniel J [1] Graham},
	month = mar,
	year = {2009},
	keywords = {economics, geography, localisation},
	pages = {63--84}
},

