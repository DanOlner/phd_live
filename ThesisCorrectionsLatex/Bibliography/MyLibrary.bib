@article{pokharel_two_2008,
	title = {A two objective model for decision making in a supply chain},
	volume = {111},
	issn = {0925-5273},
	url = {http://www.sciencedirect.com/science/article/B6VF8-4N3P02P-3/2/ca431635a7113c03f1c6382270744344},
	doi = {10.1016/j.ijpe.2007.01.006},
	abstract = {Strategic decisions on establishing a supply chain network {(SCN)} encompass more than one criterion, for example, minimization of costs and maximization of customer service levels. These criteria have to be analyzed along with constraints such as capacity commitment by the suppliers and the manufacturers for the production of a particular product. In this paper, estimated demand from various retail units, capacity commitment by suppliers, assemblers and third party warehouses have been considered as constraints in order to develop a two-objective decision-making model for the choice of suppliers and warehouses for a {SCN} design. The {SCN} is considered for the production of one product through an assembly of four modules supplied by different suppliers. It is shown that compared to the optimal solutions generated by considering only one objective, the choice of suppliers and warehouses in the network differ when two objectives are considered simultaneously. A few scenarios are developed to show the effect on the network solution due to changes in {DMs'} preferences on various objectives. This way, decision-making becomes interactive. It is expected that the concept can be used by the researchers and the {DMs} in meeting their supply chain design objectives.},
	number = {2},
	journal = {International Journal of Production Economics},
	author = {Shaligram Pokharel},
	month = feb,
	year = {2008},
	keywords = {economic calculation, planning},
	pages = {378--388}
},

