@article{hollander_securing_2005,
	title = {Securing sugar: National security discourse and the establishment of Florida's sugar-producing region},
	volume = {81},
	issn = {0013-0095},
	shorttitle = {Securing sugar},
	url = {http://apps.isiknowledge.com/full_record.do?product=UA&search_mode=GeneralSearch&qid=20&SID=S2nmnK52gaJJmjF@mjE&page=1&doc=1&colname=WOS},
	abstract = {This article explores the critical role that discourses of national security and national food self-sufficiency played in the establishment of Florida's sugar-producing region. The primary theoretical engagement is with work in economic and cultural geography that analyzes the material and discursive construction of commodities and the regions that produce them. Attention is directed toward the regulatory effects of discourse, as manifested through the establishment of state institutions, rules, and practices that regulate global sugar production and trade. The approach is historical, demonstrating the persistence of national security discourses over several decades as the broader political-economic and geopolitical contexts for {U.S.} sugar production shifted. These contextual shifts presented the sugar industry and its political supporters with discursive opportunities for framing state protectionism in the global sugar trade as vital to national security. The empirical foundation of this analysis has two methodological components, the first of which documents the role and form of discursive practices. The second component addresses the broader and larger-scale political-economic contexts for the discursive practices of Florida sugar interests-specifically a century of shifting global geopolitics and the United States's role in international affairs.},
	number = {4},
	journal = {Economic Geography},
	author = {{GM} Hollander},
	month = oct,
	year = {2005},
	keywords = {food, international},
	pages = {339--358}
},

@misc{marsh_stigmergic_2007,
	type = {{MPRA} Paper},
	title = {Stigmergic epistemology, stigmergic cognition},
	url = {http://mpra.ub.uni-muenchen.de/10004/},
	author = {Leslie Marsh and Christian Onof},
	month = jun,
	year = {2007},
	note = {To know is to cognize, to cognize is to be a culturally bounded, rationality-bounded and environmentally located agent. Knowledge
and cognition are thus dual aspects of human sociality. If social epistemology has the formation, acquisition, mediation, transmission and
dissemination of knowledge in complex communities of knowers as its subject matter, then its third party character is essentially stigmergic.
In its most generic formulation, stigmergy is the phenomenon of indirect communication mediated by modifications of the environment.
Extending this notion one might conceive of social stigmergy as the extra-cranial analog of an artificial neural network providing epistemic
structure. This paper recommends a stigmergic framework for social epistemology to account for the supposed tension between
individual action, wants and beliefs and the social corpora. We also propose that the so-called ‘‘extended mind’’ thesis offers the requisite
stigmergic cognitive analog to stigmergic knowledge. Stigmergy as a theory of interaction within complex systems theory is illustrated
through an example that runs on a particle swarm optimization algorithm.},
	keywords = {cognition},
	howpublished = {http://mpra.ub.uni-muenchen.de/10004/},
	annote = {{{\textless}p{\textgreater}Following} Parunak (2005), a stigmergic system displays characteristics, informally adduced as follows:{\textless}/p{\textgreater}
{\textless}p{\textgreater}1. A global context or environment (that can be virtual){\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{{\textless}li{\textgreater}Comprised} by an indefinite number of local environments.{\textless}/li{\textgreater}
{{\textless}li{\textgreater}Only} partially perceivable through an internal dynamics (e.g. in the case of viral marketing communication;{\textless}/li{\textgreater}
{\textless}li{\textgreater}in a network of hyperlinked documents, the maintenance of indices) that govern its temporal evolution.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}
{\textless}p{\textgreater}2. Agents{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{{\textless}li{\textgreater}There} are a multiplicity of agents populating 1 with no one individual or clustering of individuals having global knowledge.     
{\textless}ul{\textgreater}
{\textless}li{\textgreater} Rationality is bounded.{\textless}/li{\textgreater}
{\textless}li{\textgreater} Behavior is self-organized.     
{\textless}ul{\textgreater}
{\textless}li{\textgreater} Behavior is stochastic.{\textless}/li{\textgreater}
{\textless}li{\textgreater} Behavior is adaptive/dynamical.{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{\textless}p{\textgreater}- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -{\textless}br /{\textgreater}3. Novel features arise from interactions of 1 and 2, features that are neither predictable nor reducible to simpler{\textless}br /{\textgreater}constituents. [3]{\textless}/p{\textgreater}
{\textless}p{\textgreater}========{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} stigmergic interest of markets can easily be read off:{\textless}/p{\textgreater}
{\textless}ul{\textgreater}
{\textless}li{\textgreater}a market is a mechanism for the cooperation among strangers in a given environment;{\textless}/li{\textgreater}
{\textless}li{\textgreater}a market enables activity that has consequences for all its agents, despite the fact that few transactions ever directly take place in-person to in-person;{\textless}/li{\textgreater}
{\textless}li{\textgreater}the pheromone analog in a market system is common currency; [one can 'follow the money']{\textless}/li{\textgreater}
{\textless}li{\textgreater}a market has epistemic (and computational) efficiencies in that knowledge is distributed and dynamic;{\textless}/li{\textgreater}
{\textless}li{\textgreater}a market displays emergent behavior, behavior that couldn’t have been predicted.[6]{\textless}/li{\textgreater}
{\textless}/ul{\textgreater}
{\textless}p{\textgreater}========{\textless}/p{\textgreater}
{{\textless}p{\textgreater}For} us, the idea of an extra-cranial analog to neural networks takes inspiration from Hayek’s philosophical psychology (who along with Donald Hebb’s The Organization of Behavior: A Neuropsychological Theory a few years earlier) anticipated the connectionist paradigm {(Hayek,} 1952/1976). Hebbian theory is of course well known within cognitive science. Hayek’s much neglected work should be of particular interest because, as Barry Smith points out {(Smith,} 1997), Hayek distinctively made the dynamicism of complex systems the touchstone for his philosophical psychology as well as within his social philosophy in general and his philosophy of economics in particular. [8]{\textless}/p{\textgreater}
{\textless}p{\textgreater} {\textless}/p{\textgreater}}
},

