@misc{_bbc_????-3,
	title = {{BBC} {iPlayer} - Britain from Above: The Land},
	url = {http://www.bbc.co.uk/iplayer/episode/b00d4pwc/b00d4pqv/Britain_from_Above_The_Land/},
	keywords = {food, video},
	howpublished = {{http://www.bbc.co.uk/iplayer/episode/b00d4pwc/b00d4pqv/Britain\_from\_Above\_The\_Land/}},
	annote = {{{\textless}p{\textgreater}Archaeologist} Chris Going - found photos of East Anglia, taken by German bombers flying over. 1940. He's from Geoinformation Historic.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}No} major cities, no road links, no airports - just small villages and endless farms. A landscape about to disappear.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Also:} land-use maps from the early 1930s. Each one created by hand by a quarter of a million volunteers. 22,000 sheets. Kids mostly - going to look at the countryside to record and describe every piece of land in their neighbourhood.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Dreamed} up by geography prof Laurence Dudley Stamp. {"A} man obsessed with protecting Britain's agricultural land from Urban sprawl."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}OS} had mapped - but not land-use.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Dr} Ruth Sweatnam: expert on landscape change. East Anglia.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Much} more mixed farming system. Wheat, beat, potatoes, celery, lettuces. All interleaved. Dense complex pattern of land use and ownership.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"To} modern eyes it looks totally inefficient and in many ways it was."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Farm} use not changed much - 1930s still people and horse-powered. 100 men and women on a farm. Hand work and piecework. Ditching work. All hard labour.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Chris} Going: pictures show how much time and effort to harvest. Pic1: 30s harvest1.{\textless}/p{\textgreater}
{\textless}p{\textgreater}"harvest has just taken place. Wheat has been cut by hand but hasn't yet been cut into stooks. Across the road (pic2) you can see the large hay cart and the horse in front, and its slowly going round the field. Half of the field's been done, the other half is yet to be done."{\textless}/p{\textgreater}
{\textless}p{\textgreater}"being farmed in effectively a medieval manner."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Industrialisation:} hadn't mechanised farms. 1 in 15 farms had any access to a tractor. 30s. Over a million - 1/5 of working pop. But inefficient - 90\% of grain imported. Mostly from Canada. No incentive for farmers to invest - cheaper to import food.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Then} war! Essential food supplies cut off by blockade. So how to produce food? Couldn't just do it on allotments.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"Stamp's} maps showed precisely where to do it." Govt realised how important they were, and funded their publicaiton.{\textless}/p{\textgreater}
{\textless}p{\textgreater}"while in towns and cities, 1.5 million people worked on allotments, out in the countryside, over 300,000 unproductive farms were targeted for direct government aid and effectively commandeered. An additional 5.5 million acres was identified as capable of growing crops. 200,000 more labourers  and 15,000 new tractors eased the workload. And in 5 years, food production almost doubled.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Post-war:} politicians said "never again! Make more food!"{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Farmers:} worried that if they produced more, price would go down. So govt guaranteed surplus payments. In the 3 decades afer the war, investment in machiney rose x10. Food production went up by 200\%.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}But} the land changed: average field size tripled. 12,000 miles of hedgerow were 'grubbed up.'{\textless}/p{\textgreater}
{\textless}p{\textgreater}10s of 1000s of farming jobs disappeared.{\textless}/p{\textgreater}
{\textless}p{\textgreater}'67: last farm in East Anglia to 'bow to economic pressure' and mechanise. Used to have a whole village working there. Now 1 full time worker, plus contractors, to work 3000 acres.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Another} farmer: "we used to employ when I was a boy 80 workers. They didn't have running water, they didn't have indoor toilets, they had terrible pay. The conditions they worked in were vile - cold, dust, hot, out in all weathers. Therefore, in the 1940s, 50s and 60s, the one single ambition of anybody who worked in agriculture - in the 'good old days' - was to get the hell out of agriculture - into any job, any factory job - because it was preferable to working on farms."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}The} land emptied, smallholders disappeared. Large scale grain production became the norm.{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Rise} and rise of motorcar... "opening up the rural landscape."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}"In} the course of his career, oliver walsthom has seen the fortunes of britain's farmers change out of all recognition. From the intensive heyday of the 60s and 70s when he made big profits from his big fields, to the 80s when supply outstripped demand and food prices fell - to the point where setting aside land for conservation paid better than actually growing food."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}Oliver:} "for the last twenty years we've been getting poorer and poorer. For three of the past five years we've actually lost money... // Cost of fertiliser doubled, cost of chemicals doubled, cost of fuel going into the tractor tripled..."{\textless}/p{\textgreater}
{{\textless}p{\textgreater}But} it's changed again - a world food shortage is impacting on East Anglia. {"Promises} to breathe new life into farming."{\textless}/p{\textgreater}
{\textless}p{\textgreater}£150 a tonne - nearly double what it was eighteen months ago. Competition for East Anglia's land is intensifying. Farming competes with housing, airports, roads "and what remains of any natural wilderness."{\textless}/p{\textgreater}}
},

@article{krugman_increasing_2009-1,
	title = {The Increasing Returns Revolution in Trade and Geography},
	volume = {99},
	issn = {0002-8282},
	url = {http://apps.isiknowledge.com/full_record.do?product=WOS&search_mode=GeneralSearch&qid=1&SID=P1M6hL8JlLll8cb4F3b&page=1&doc=1},
	doi = {10.1257/aer.99.3.561},
	abstract = {Thirty years have passed since a small group of theorists began applying concepts and tools from industrial organization to the analysis of international trade. The new models of trade that emerged from that work didn't supplant traditional trade theory so much as supplement it, creating an integrated view that made sense of aspects of world trade that had previously posed major puzzles. The "new trade theory"-an unfortunate phrase, now quite often referred to as "the old new trade theory"-also helped build a bridge between the analysis of trade between countries and the location of production within countries. In this paper I will try to retrace the steps and, perhaps even more important, the state of mind that made this intellectual transformation possible. At the end I'll also ask about the relevance of those once-revolutionary insights in a world economy that, as I'll explain, is arguably more classical now than it was when the revolution in trade theory began.},
	number = {3},
	journal = {{AMERICAN} {ECONOMIC} {REVIEW}},
	author = {P Krugman},
	month = jun,
	year = {2009},
	keywords = {geographical economics},
	pages = {561--571}
},

