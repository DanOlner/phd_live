	abstract = {Engel's Law is the observed phenomenon that when a family's income increases, the proportion of money they spend on food decreases. As an extension of this, the goods are divided into the two groups - inferior and normal goods. In consumer theory, an inferior good is a good that decreases in demand when the consumer's income rises, unlike normal goods, for which the opposite is observed. As an inferior good, tots of sources use potato as an example. According to that, the potato is marked as a cheap, Low-valued food article. One of the most accepted methods for Life standard determination is Gross Domestic Product per capita. Using this method, a significant increase of Life standard in Croatia can be noticed. According to the data from the Yearly Statistics {GDP} in Croatia has increased by 278 percent during the period 1992-2005. Consumption of potato in the same period has not changed. According to official statistical data about potato consumption, yearly potato consumption per capita in 2005 was 45,0 kg. It was V percent more than in 2002 when the potato consumption per capita was 43,4 kg. Income elasticity can be easily calculated as ratio of percent change of potato consumption and percent change of income. In this case, income elasticity for potato is 0,01328 what is a clear indicator of potato income inelasticity in Croatia. Therefore, one can conclude that potato in the Croatian example is a normal, inelastic good.},
	journal = {{POTATO} {PRODUCTION} {AND} {INNOVATIVE} {TECHNOLOGIES}},
	author = {L Hodelan and V Par and M Njavro},
	year = {2007},
	keywords = {economics, engel's law},
	pages = {64--69}
},

@article{stolze_policy_2009,
	title = {Policy for organic farming: Rationale and concepts},
	volume = {34},
