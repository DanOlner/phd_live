
@article{summers_scientific_1991,
	title = {The Scientific Illusion in Empirical Macroeconomics},
	volume = {93},
	issn = {03470520},
	url = {http://www.jstor.org/stable/3440321},
	doi = {10.2307/3440321},
	abstract = {It is argued that formal econometric work, where elaborate technique is used to apply theory to data or isolate the direction of causal relationships when they are not obvious a priori, virtually always fails. The only empirical research that has contributed to thinking about substantive issues and the development of economics is pragmatic empirical work, based on methodological principles directly opposed to those that have become fashionable in recent years.},
	number = {2},
	urldate = {2011-01-12},
	journal = {The Scandinavian Journal of Economics},
	author = {Summers, Lawrence H.},
	month = jun,
	year = {1991},
	keywords = {ace},
	pages = {129--148}
},

@article{duranton_micro-foundations_2003,
	title = {Micro-Foundations of Urban Agglomeration Economies},
	volume = {No. 9931},
	url = {http://www.nber.org/papers/w9931},
	abstract = {This handbook chapter studies the theoretical micro-foundations of urban agglomeration economies. We distinguish three types of micro-foundations, based on sharing, matching, and learning mechanisms. For each of these three categories, we develop one or more core models in detail and discuss the literature in relation to those models. This allows us to give a precise characterisation of some of the main theoretical underpinnings of urban agglomeration economies, to discuss modelling issues that arise when working with these tools, and to compare different sources of agglomeration economies in terms of the aggregate urban outcomes they produce as well as in terms of their normative implications.},
	urldate = {2009-07-20},
	journal = {National Bureau of Economic Research Working Paper Series},
	author = {Duranton, Giles and Puga, Diego},
	month = sep,
	year = {2003},
	keywords = {agglomeration},
	file = {microfoundationsofUrbanAgglom.pdf:M:\articles\microfoundationsofUrbanAgglom.pdf:application/pdf}
},

@article{leamer_economy_2001,
	title = {The economy geography of the Internet age},
	volume = {32},
	issn = {00472506},
	abstract = {This paper combines the perspective of an international economist with that of an economic geographer to reflect on how and to what extent the Internet will affect the location of economic activity. Even after the very substantial transportation and communication improvements during the 20th century, most exchanges of physical goods continue to take place within geograhically-limited neighborhoods. It is argued that the Internet will produce more of the same: Certain forces for deagglomeration, but offsetting and possibly stronger tendencies toward agglomeration.},
	number = {4},
	journal = {Journal of International Business Studies},
	author = {Leamer, {E.E.} and Storper, M.},
	year = {2001},
	pages = {641}
},

@article{ojo_journey_1973,
	title = {Journey to Agricultural Work in Yorubaland},
	volume = {63},
	issn = {0004-5608},
	url = {http://www.jstor.org/stable/2561952},
	abstract = {{\textless}p{\textgreater}Journeys to farms in Idanre are mainly on foot, and the distances are considerable. The volume of commuters in relation to distance conforms to a model of distance growth-decay function rather than to the conventional distance decay function. The average critical isochrone marking the transition from growth to decay is six miles (10 km), with variations along different routes, and from weekdays to weekends. Distance is the most significant variable influencing periodic commuting designed to minimize the journey to farms. Periodic commuting encourages the growth of satellite rural settlements at the expense of the main town and leads to deglomeration, which has economic, social, and cultural implications.},
	number = {1},
	urldate = {2011-06-26},
	journal = {Annals of the Association of American Geographers},
	author = {Ojo, G. J. Afolabi},
	month = mar,
	year = {1973},
	pages = {85--96}
},

