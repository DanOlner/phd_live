@article{holub_anti-equilibrium_1977,
	title = {Anti-equilibrium theory vs. equilibrium theory},
	volume = {125},
	url = {http://dx.doi.org/10.1007/BF01479119},
	doi = {10.1007/BF01479119},
	abstract = {Summary Anti-equilibrium models wishing to present a real alternative to the equilibrium models cannot confine themselves to replacing the equilibrium conditions that are entailed by corresponding disequilibrium conditions, while simply adopting the rest of the model. It is, rather, essential for the establishment of an anti-equilibrium model to first develop a new basic principle, which differs from the ‘general insight‘ of equilibrium theory in essential points. This basic idea may then act as a nucleus for the creation of alternative questions, definitions, and problem-solving strategies. This article attempts to draw some first conclusions from that point of view, using a debate between J. Kornai and F. H. Hahn as an example.},
