\begin{theglossary}\glossaryheader
\glsgroupheading{B}\relax \glsresetentrylist %
\glossaryentryfield{bertcomp}{\glsnamefont{Bertrand competition}}{A competitive situation where one firm can take the whole market by lowering their price a tiny amount.}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{112}\delimN 
		\setentrycounter{page}\glsnumberformat{149}}}\glsgroupskip
\glsgroupheading{C}\relax \glsresetentrylist %
\glossaryentryfield{coremodel}{\glsnamefont{core model}}{Shortened name for Krugman's core-periphery model of regional location.}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{5}\delimN 
