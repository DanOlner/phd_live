\glsgroupheading{D}\relax \glsresetentrylist %
\glossaryentryfield{dxs}{\glsnamefont{Dixit Stiglitz model}}{Monopolistic Competition model first published by Dixit and Stiglitz in their 1977 paper, 'Monopolistic Competition and Optimum Product Diversity'}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{18}\delimN 
		\setentrycounter{page}\glsnumberformat{24\delimR 26}\delimN 
		\setentrycounter{page}\glsnumberformat{67}}}\glsgroupskip
\glsgroupheading{E}\relax \glsresetentrylist %
\glossaryentryfield{eos}{\glsnamefont{economies of scale}}{First of the two forms of `increasing returns' used in the thesis: a larger input into a production function means a more-than-proportional increase in output.}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{24}\delimN 
		\setentrycounter{page}\glsnumberformat{100\delimR 102}\delimN 
		\setentrycounter{page}\glsnumberformat{108}\delimN 
		\setentrycounter{page}\glsnumberformat{111}\delimN 
		\setentrycounter{page}\glsnumberformat{152}\delimN 
		\setentrycounter{page}\glsnumberformat{154}}}%
\glossaryentryfield{eosub}{\glsnamefont{elasticity of substitution}}{Another way of describing the economic dynamic described by the `Constant Elasticity of Substitution' (CES) function. The other, inversely, is `love of variety'. The more two goods are substitutable for each other, the higher the elasticity of substitution between them, and the lower the `love of variety'. In this this, elasticity of substitution only applies to people's utility functions, not inputs into firms' production, so `love of variety' is used.}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{18}\delimN 
		\setentrycounter{page}\glsnumberformat{52}}}\glsgroupskip
\glsgroupheading{I}\relax \glsresetentrylist %
\glossaryentryfield{increts}{\glsnamefont{increasing returns}}{Any situation where, for a given set of inputs, the output is more than proportionally larger. Increasing returns are thus non-linear. This thesis uses two types of increasing returns, `love of variety' and `economies of scale' (see other glossary entries).}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{13\delimN 14}\delimN 
		\setentrycounter{page}\glsnumberformat{20\delimN 21}\delimN 
		\setentrycounter{page}\glsnumberformat{24}\delimN 
		\setentrycounter{page}\glsnumberformat{26}\delimN 
		\setentrycounter{page}\glsnumberformat{31}\delimN 
		\setentrycounter{page}\glsnumberformat{36}\delimN 
		\setentrycounter{page}\glsnumberformat{50\delimR 53}\delimN 
		\setentrycounter{page}\glsnumberformat{73}\delimN 
		\setentrycounter{page}\glsnumberformat{89}\delimN 
		\setentrycounter{page}\glsnumberformat{99\delimN 100}\delimN 
		\setentrycounter{page}\glsnumberformat{109}\delimN 
		\setentrycounter{page}\glsnumberformat{149}}}\glsgroupskip
\glsgroupheading{L}\relax \glsresetentrylist %
\glossaryentryfield{lov}{\glsnamefont{love of variety}}{Second of the two forms of `increasing returns'. More formally, elasticity of substitution. High love of variety is low elasticity of substitution: for a given total quantity of goods, consumers prefer a mix of different varieties, and thus are less willing to substitute one for the other.}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{14}\delimN 
		\setentrycounter{page}\glsnumberformat{18\delimN 19}\delimN 
		\setentrycounter{page}\glsnumberformat{26}\delimN 
		\setentrycounter{page}\glsnumberformat{52}\delimN 
		\setentrycounter{page}\glsnumberformat{63}\delimN 
		\setentrycounter{page}\glsnumberformat{83}\delimN 
		\setentrycounter{page}\glsnumberformat{100\delimN 101}\delimN 
		\setentrycounter{page}\glsnumberformat{117}\delimN 
		\setentrycounter{page}\glsnumberformat{125}\delimN 
		\setentrycounter{page}\glsnumberformat{128\delimN 129}\delimN 
		\setentrycounter{page}\glsnumberformat{147}\delimN 
		\setentrycounter{page}\glsnumberformat{149}\delimN 
		\setentrycounter{page}\glsnumberformat{154}\delimN 
		\setentrycounter{page}\glsnumberformat{157}\delimN 
		\setentrycounter{page}\glsnumberformat{159}\delimN 
		\setentrycounter{page}\glsnumberformat{163}}}\glsgroupskip
\glsgroupheading{M}\relax \glsresetentrylist %
\glossaryentryfield{margrev}{\glsnamefont{marginal revolution}}{``the nearly simultaneous but completely independent discovery in the early 1870s by Jevons, Menger and Walras of the principle of diminishing marginal utility as the fundamental building block of a new kind of static microeconomics.'' (\citealt {blaug_economic_1997} p.277)}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{58}}}%
\glossaryentryfield{monocomp}{\glsnamefont{monopolistic competition}}{In this thesis, unless otherwise stated, this refers to the approach to imperfect competition developed by Dixit and Stiglitz (1977) in which each firm is guaranteed by their increasing returns to produce one unique variety of good. They have a monopoly on that single good due to increasing returns, but there are enough firms in the market for the price-setting behaviour to not affect others.}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{19}\delimN 
		\setentrycounter{page}\glsnumberformat{24}\delimN 
		\setentrycounter{page}\glsnumberformat{32}\delimN 
		\setentrycounter{page}\glsnumberformat{63\delimN 64}\delimN 
		\setentrycounter{page}\glsnumberformat{74}\delimN 
		\setentrycounter{page}\glsnumberformat{83\delimN 84}\delimN 
		\setentrycounter{page}\glsnumberformat{99}}}\glsgroupskip
\glsgroupheading{R}\relax \glsresetentrylist %
\glossaryentryfield{repag}{\glsnamefont{representative agent}}{Term used to describe the use of a single agent as a stand-in for all agents in an economic model. The `core model' uses this.}{\relax }{\glossaryentrynumbers{\relax 
		\setentrycounter{page}\glsnumberformat{52}\delimN 
		\setentrycounter{page}\glsnumberformat{79}\delimN 
		\setentrycounter{page}\glsnumberformat{90}\delimN 
		\setentrycounter{page}\glsnumberformat{166}}}%
\end{theglossary}\glossarypostamble
